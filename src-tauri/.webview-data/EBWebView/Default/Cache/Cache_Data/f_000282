ound 0.15s, color 0.15s;\n}\n\n.layout__nav-item:hover {\n  background: var(--bg-elevated);\n  color: var(--fg);\n}\n\n.layout__nav-item--active {\n  background: var(--accent);\n  color: #fff;\n}\n\n.layout__main {\n  flex: 1;\n  overflow-y: auto;\n  padding: 32px 40px;\n}\n\n/* ============ 页面通用 ============ */\n\n.page {\n  max-width: 880px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.page__header {\n  border-bottom: 1px solid var(--border);\n  padding-bottom: 16px;\n}\n\n.page__title {\n  margin: 0;\n  font-size: 24px;\n  font-weight: 700;\n}\n\n.page__subtitle {\n  margin: 6px 0 0;\n  color: var(--fg-muted);\n  font-size: 13px;\n}\n\n.card {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 20px 24px;\n}\n\n.card__title {\n  margin: 0 0 16px;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--fg-muted);\n}\n\n/* ============ 表单 ============ */\n\n.form-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.form-row {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.field-label {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.input {\n  background: var(--bg);\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  padding: 9px 12px;\n  color: var(--fg);\n  font-size: 14px;\n  width: 100%;\n  outline: none;\n  transition: border-color 0.15s;\n}\n\n.input:focus {\n  border-color: var(--accent);\n}\n\n.input--inline {\n  width: auto;\n  min-width: 120px;\n  padding: 5px 10px;\n}\n\n.textarea {\n  resize: vertical;\n  min-height: 56px;\n  font-family: inherit;\n}\n\n/* ============ 按钮 ============ */\n\n.btn {\n  background: var(--bg);\n  border: 1px solid var(--border-strong);\n  color: var(--fg);\n  padding: 8px 16px;\n  border-radius: 6px;\n  font-size: 13px;\n  transition: background 0.15s, border-color 0.15s;\n}\n\n.btn:hover {\n  background: var(--bg-elevated);\n  border-color: var(--accent);\n}\n\n.btn--primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\n\n.btn--primary:hover {\n  background: var(--accent-hover);\n  border-color: var(--accent-hover);\n}\n\n.btn--small {\n  padding: 4px 10px;\n  font-size: 12px;\n}\n\n.btn-row {\n  display: flex;\n  gap: 8px;\n  margin-top: 8px;\n}\n\n/* ============ 状态徽章 ============ */\n\n.badge {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 999px;\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.badge--active {\n  background: rgba(79, 140, 255, 0.18);\n  color: var(--accent);\n}\n\n.badge--pending {\n  background: rgba(210, 153, 34, 0.18);\n  color: var(--warn);\n}\n\n.badge--done {\n  background: rgba(63, 185, 80, 0.18);\n  color: var(--ok);\n}\n\n/* ============ 通用辅助 ============ */\n\n.muted {\n  color: var(--fg-muted);\n}\n\n.alert {\n  padding: 10px 14px;\n  border-radius: 8px;\n  font-size: 13px;\n}\n\n.alert--error {\n  background: rgba(248, 81, 73, 0.12);\n  color: var(--error);\n  border: 1px solid rgba(248, 81, 73, 0.3);\n}\n\n/* ============ Today: Active Session ============ */\n\n.active-session {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.active-session__main {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 16px;\n}\n\n.active-session__item {\n  font-weight: 600;\n}\n\n.active-session__task {\n  color: var(--fg-muted);\n}\n\n.active-session__time {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.active-session__end-form {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 8px;\n}\n\n.start-form {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n/* ============ 列表 ============ */\n\n.task-list,\n.session-list,\n.goal-list,\n.item-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.task-list__item,\n.session-list__item,\n.goal-list__item,\n.item-list__item {\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.task-list__item--done {\n  opacity: 0.55;\n}\n\n.task-list__item {\n  flex-direction: row;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.task-list__main {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.task-list__title {\n  font-weight: 500;\n}\n\n.task-list__meta {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.task-list__actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.session-list__head,\n.goal-list__head,\n.item-list__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.session-list__item-name,\n.goal-list__name,\n.item-list__name {\n  font-weight: 600;\n}\n\n.session-list__time,\n.goal-list__time,\n.item-list__time {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.goal-list__actions {\n  margin-top: 4px;\n}\n\n/* ============ Learning Structure Tree ============ */\n\n.tree,\n.tree-children {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.tree {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.tree-children {\n  margin-top: 4px;\n}\n\n.tree-node {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.tree-node__row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  min-height: 36px;\n}\n\n.tree-node__toggle {\n  width: 18px;\n  height: 18px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  color: var(--fg-muted);\n  cursor: pointer;\n  font-size: 12px;\n  flex-shrink: 0;\n}\n\n.tree-node__toggle:hover {\n  color: var(--fg);\n}\n\n.tree-node__toggle--leaf {\n  cursor: default;\n}\n\n.tree-node__name {\n  font-weight: 500;\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tree-node__desc {\n  font-size: 12px;\n  color: var(--fg-muted);\n  padding: 2px 12px 4px;\n}\n\n.tree-node__path {\n  font-size: 11px;\n  color: var(--fg-muted);\n  opacity: 0.8;\n  padding: 0 12px 2px;\n}\n\n.tree-node__time {\n  font-size: 11px;\n  color: var(--fg-muted);\n  opacity: 0.7;\n  padding: 0 12px 6px;\n}\n\n.tree-node__add-child {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px 12px;\n  background: var(--bg-elevated);\n  border: 1px dashed var(--border-strong);\n  border-radius: 6px;\n  margin: 4px 0;\n}\n\n.session-list__note,\n.goal-list__desc,\n.item-list__desc {\n  font-size: 13px;\n  color: var(--fg);\n}\n\n.item-list__status-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n}\n\n.item-list__goal {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n/* ============ History: Stats ============ */\n\n.stats-row {\n  display: flex;\n  gap: 24px;\n  flex-wrap: wrap;\n}\n\n.stat {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.stat__label {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.stat__value {\n  font-size: 22px;\n  font-weight: 700;\n  color: var(--accent);\n}\n\n/* ============ Profile Gate ============ */\n\n.profile-gate {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  padding: 40px 20px;\n  gap: 24px;\n}\n\n.profile-gate__loading {\n  color: var(--fg-muted);\n  font-size: 15px;\n}\n\n.profile-gate__card {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  padding: 48px 40px;\n  text-align: center;\n  max-width: 480px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n}\n\n.profile-gate__header {\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.profile-gate__title {\n  font-size: 28px;\n  font-weight: 700;\n  margin: 0;\n}\n\n.profile-gate__subtitle {\n  font-size: 16px;\n  color: var(--accent);\n  margin: 0;\n}\n\n.profile-gate__desc {\n  font-size: 14px;\n  color: var(--fg-muted);\n  line-height: 1.6;\n  margin: 0;\n}\n\n.profile-gate__btn {\n  margin-top: 8px;\n  padding: 10px 32px;\n  font-size: 15px;\n}\n\n.profile-gate__error {\n  background: rgba(248, 81, 73, 0.12);\n  color: var(--error);\n  border: 1px solid rgba(248, 81, 73, 0.3);\n  padding: 10px 16px;\n  border-radius: 8px;\n  font-size: 13px;\n  max-width: 480px;\n  text-align: center;\n}\n\n/* ============ Profile Selector ============ */\n\n.profile-selector__list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 100%;\n  max-width: 480px;\n}\n\n.profile-card {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 20px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.profile-card__name {\n  font-size: 18px;\n  font-weight: 700;\n}\n\n.profile-card__type {\n  font-size: 13px;\n  color: var(--accent);\n}\n\n.profile-card__meta {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.profile-card__desc {\n  font-size: 13px;\n  color: var(--fg);\n  margin-top: 4px;\n}\n\n.profile-card .btn {\n  align-self: flex-start;\n  margin-top: 8px;\n}\n\n/* ============ Profile Create Form ============ */\n\n.profile-create__form {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 28px 32px;\n  width: 100%;\n  max-width: 480px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.form-label {\n  font-size: 13px;\n  color: var(--fg-muted);\n  margin-bottom: 4px;\n  display: block;\n}\n\n.form-input {\n  width: 100%;\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  padding: 8px 12px;\n  font-size: 14px;\n  outline: none;\n}\n\n.form-input:focus {\n  border-color: var(--accent);\n}\n\n/* ============ Layout: Profile Header ============ */\n\n.layout__profile {\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.layout__profile-label {\n  font-size: 11px;\n  color: var(--fg-muted);\n  margin-bottom: 4px;\n}\n\n.layout__profile-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  padding: 8px 12px;\n  color: var(--fg);\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.layout__profile-btn:hover {\n  border-color: var(--accent);\n}\n\n.layout__profile-name {\n  flex: 1;\n  text-align: left;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.layout__profile-arrow {\n  font-size: 10px;\n  color: var(--fg-muted);\n}\n\n.layout__profile-menu {\n  margin-top: 4px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.layout__profile-menu-item {\n  display: block;\n  width: 100%;\n  text-align: left;\n  background: transparent;\n  border: none;\n  padding: 8px 12px;\n  color: var(--fg);\n  font-size: 13px;\n}\n\n.layout__profile-menu-item:hover {\n  background: var(--bg);\n}\n\n.layout__error {\n  margin: 8px 16px;\n  padding: 8px 12px;\n  background: rgba(248, 81, 73, 0.12);\n  color: var(--error);\n  border: 1px solid rgba(248, 81, 73, 0.3);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n/* ============ Profile Calendar ============ */\n\n.calendar__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n\n.calendar__header .card__title {\n  margin: 0;\n}\n\n.calendar__nav {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.calendar__month-label {\n  font-size: 14px;\n  font-weight: 600;\n  min-width: 90px;\n  text-align: center;\n}\n\n.calendar__grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 6px;\n}\n\n.calendar__grid--head {\n  margin-bottom: 6px;\n}\n\n.calendar__weekday {\n  text-align: center;\n  font-size: 12px;\n  color: var(--fg-muted);\n  padding: 2px 0;\n}\n\n.calendar__cell {\n  min-height: 64px;\n  border-radius: 6px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  padding: 4px 6px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  font-size: 11px;\n  text-align: left;\n}\n\n.calendar__cell--blank {\n  background: transparent;\n  border-color: transparent;\n}\n\nbutton.calendar__cell--day {\n  cursor: pointer;\n  color: var(--fg);\n}\n\nbutton.calendar__cell--day:hover {\n  border-color: var(--accent);\n}\n\n.calendar__cell--today {\n  border-color: var(--accent);\n}\n\n.calendar__cell--selected {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 1px var(--accent);\n}\n\n/* 活动强度：只表示活动量，不代表学习效果 */\n.calendar__cell--level1 {\n  background: rgba(79, 140, 255, 0.10);\n}\n\n.calendar__cell--level2 {\n  background: rgba(79, 140, 255, 0.22);\n}\n\n.calendar__cell--level3 {\n  background: rgba(79, 140, 255, 0.34);\n}\n\n.calendar__day-num {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.calendar__day-summary {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  color: var(--fg-muted);\n  font-size: 10px;\n  line-height: 1.3;\n  overflow: hidden;\n}\n\n.calendar__day-line {\n  white-space: nowrap;\n}\n\n.calendar__detail {\n  margin-top: 12px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border);\n}\n\n.calendar__detail-title {\n  font-size: 15px;\n  font-weight: 600;\n  margin-bottom: 10px;\n}\n\n.calendar__detail-stats {\n  display: flex;\n  gap: 32px;\n  flex-wrap: wrap;\n}\n\n.calendar__detail-stats .stat__value {\n  font-size: 18px;\n}\n\n/* ============ Knowledge Workspace（知识体系工作区） ============ */\n\n/* 工作区占满视口、自己管理滚动（仅当渲染 .knowledge 时覆盖默认 main padding） */\n.layout__main:has(> .knowledge) {\n  padding: 0;\n  overflow: hidden;\n}\n\n.knowledge {\n  display: flex;\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n}\n\n/* ---- 左侧：知识树 ---- */\n\n.knowledge__tree {\n  width: 280px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  border-right: 1px solid var(--border);\n  background: var(--bg-sidebar);\n  min-height: 0;\n}\n\n.knowledge__goal {\n  padding: 10px 12px 4px;\n}\n\n.knowledge__goal-label {\n  display: block;\n  font-size: 11px;\n  color: var(--fg-muted);\n  margin-bottom: 4px;\n}\n\n.knowledge__goal-select {\n  width: 100%;\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 6px 8px;\n  font-size: 13px;\n}\n\n.knowledge__search {\n  padding: 10px 12px;\n}\n\n.knowledge__search-input {\n  width: 100%;\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 7px 10px;\n  font-size: 13px;\n  outline: none;\n}\n\n.knowledge__search-input:focus {\n  border-color: var(--accent);\n}\n\n.knowledge__tree-body {\n  flex: 1;\n  overflow-y: auto;\n  padding: 4px 8px;\n  min-height: 0;\n}\n\n.knowledge__hint {\n  padding: 8px;\n}\n\n.knowledge__tree-empty {\n  padding: 20px 12px;\n}\n\n.knowledge__empty-title {\n  font-size: 15px;\n  font-weight: 600;\n  margin: 0 0 6px;\n}\n\n/* 搜索结果（平铺 + 路径提示） */\n.knowledge__search-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.knowledge__search-item {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  width: 100%;\n  text-align: left;\n  background: transparent;\n  border: none;\n  border-radius: 6px;\n  padding: 6px 10px;\n  cursor: pointer;\n  color: var(--fg);\n}\n\n.knowledge__search-item:hover {\n  background: var(--bg-elevated);\n}\n\n.knowledge__search-item--active {\n  background: rgba(79, 140, 255, 0.15);\n}\n\n.knowledge__search-name {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.knowledge__search-path {\n  font-size: 11px;\n  color: var(--fg-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* 树节点 */\n.knowledge__nodes {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n}\n\n.knowledge__nodes--child {\n  padding-left: 14px;\n  border-left: 1px solid var(--border);\n  margin-left: 13px;\n}\n\n.knowledge__node-row {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  border-radius: 6px;\n  padding: 1px 2px;\n  min-height: 30px;\n}\n\n.knowledge__node-row:hover {\n  background: var(--bg-elevated);\n}\n\n.knowledge__node-row--active {\n  background: rgba(79, 140, 255, 0.18);\n}\n\n.knowledge__node-toggle {\n  width: 22px;\n  height: 24px;\n  flex-shrink: 0;\n  background: transparent;\n  border: none;\n  color: var(--fg-muted);\n  font-size: 11px;\n  cursor: pointer;\n}\n\n.knowledge__node-toggle--leaf {\n  cursor: default;\n  color: var(--border-strong);\n}\n\n.knowledge__node-name {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  background: transparent;\n  border: none;\n  color: var(--fg);\n  font-size: 13px;\n  padding: 4px 2px;\n  cursor: pointer;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.knowledge__node-menu-btn {\n  flex-shrink: 0;\n  background: transparent;\n  border: none;\n  color: var(--fg-muted);\n  font-size: 12px;\n  letter-spacing: 1px;\n  padding: 4px 6px;\n  border-radius: 4px;\n  cursor: pointer;\n  opacity: 0;\n}\n\n.knowledge__node-row:hover .knowledge__node-menu-btn {\n  opacity: 1;\n}\n\n.knowledge__node-menu-btn:hover {\n  background: var(--bg);\n  color: var(--fg);\n}\n\n/* 节点 ··· 菜单 */\n.knowledge__menu-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 10;\n}\n\n.knowledge__menu {\n  position: absolute;\n  top: 28px;\n  right: 4px;\n  z-index: 11;\n  min-width: 120px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  padding: 4px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n  display: flex;\n  flex-direction: column;\n}\n\n.knowledge__menu-item {\n  background: transparent;\n  border: none;\n  text-align: left;\n  color: var(--fg);\n  font-size: 13px;\n  padding: 7px 10px;\n  border-radius: 5px;\n  cursor: pointer;\n}\n\n.knowledge__menu-item:hover {\n  background: var(--bg);\n}\n\n.knowledge__menu-item--danger {\n  color: var(--error);\n}\n\n/* 内联新建 / 重命名输入框 */\n.knowledge__new-input {\n  width: 100%;\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--accent);\n  border-radius: 6px;\n  padding: 6px 10px;\n  font-size: 13px;\n  outline: none;\n}\n\n.knowledge__new-input--inline {\n  flex: 1;\n  min-width: 0;\n}\n\n.knowledge__add-child {\n  padding: 4px 4px 4px 16px;\n  margin-left: 13px;\n}\n\n.knowledge__tree-footer {\n  padding: 10px 12px;\n  border-top: 1px solid var(--border);\n}\n\n.knowledge__new-root {\n  width: 100%;\n  background: transparent;\n  border: 1px dashed var(--border-strong);\n  border-radius: 6px;\n  color: var(--fg-muted);\n  font-size: 13px;\n  padding: 8px;\n  cursor: pointer;\n}\n\n.knowledge__new-root:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n/* ---- 右侧：知识编辑器 ---- */\n\n.knowledge__main {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  padding: 16px 24px 12px;\n  position: relative;\n  min-height: 0;\n}\n\n.knowledge__editor-empty {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.knowledge__breadcrumb {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin-bottom: 6px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.knowledge__title-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.knowledge__title {\n  flex: 1;\n  min-width: 0;\n  background: transparent;\n  border: none;\n  border-bottom: 1px solid transparent;\n  color: var(--fg);\n  font-size: 22px;\n  font-weight: 700;\n  padding: 2px 0;\n  outline: none;\n}\n\n.knowledge__title:hover {\n  border-bottom-color: var(--border);\n}\n\n.knowledge__title:focus {\n  border-bottom-color: var(--accent);\n}\n\n.knowledge__mastery {\n  flex-shrink: 0;\n  background: var(--bg);\n  color: var(--fg-muted);\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  font-size: 12px;\n  padding: 3px 10px;\n  outline: none;\n  cursor: pointer;\n}\n\n.knowledge__stats {\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin: 6px 0 10px;\n}\n\n.knowledge__content {\n  flex: 1;\n  width: 100%;\n  min-height: 60vh;\n  resize: none;\n  background: transparent;\n  border: none;\n  color: var(--fg);\n  font-size: 14px;\n  line-height: 1.75;\n  font-family: inherit;\n  outline: none;\n  padding: 0;\n}\n\n.knowledge__content::placeholder {\n  color: var(--fg-muted);\n  opacity: 0.7;\n}\n\n.knowledge__editor-foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-top: 8px;\n  border-top: 1px solid var(--border);\n  min-height: 36px;\n}\n\n.knowledge__save-status {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.knowledge__save-status--saving {\n  color: var(--warn);\n}\n\n.knowledge__save-status--saved {\n  color: var(--ok);\n}\n\n.knowledge__save-status--error {\n  color: var(--error);\n}\n\n.knowledge__retry {\n  background: transparent;\n  border: 1px solid var(--error);\n  border-radius: 4px;\n  color: var(--error);\n  font-size: 11px;\n  padding: 1px 8px;\n  cursor: pointer;\n}\n\n.knowledge__error {\n  position: absolute;\n  bottom: 48px;\n  left: 24px;\n  right: 24px;\n  background: rgba(248, 81, 73, 0.12);\n  color: var(--error);\n  border: 1px solid rgba(248, 81, 73, 0.3);\n  border-radius: 8px;\n  padding: 8px 12px;\n  font-size: 12px;\n}\n\n/* 无 Goal / 空状态 */\n.knowledge__empty {\n  max-width: 420px;\n  margin: 80px auto;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  align-items: center;\n}\n\n/* ============ V2 Shell：档案区 ============ */\n\n.shell-profile {\n  position: relative;\n  padding: 0 8px;\n}\n\n.shell-profile__btn {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 2px;\n  width: 100%;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 10px 12px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.shell-profile__btn:hover {\n  border-color: var(--accent);\n}\n\n.shell-profile__name {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--fg);\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.shell-profile__sub {\n  font-size: 11px;\n  color: var(--fg-muted);\n}\n\n.shell-profile__arrow {\n  position: absolute;\n  top: 12px;\n  right: 16px;\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.shell-profile__backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 30;\n}\n\n.shell-profile__menu {\n  position: absolute;\n  top: calc(100% + 4px);\n  left: 8px;\n  right: 8px;\n  z-index: 31;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 10px;\n  padding: 4px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n  display: flex;\n  flex-direction: column;\n}\n\n.shell-profile__menu-item {\n  background: transparent;\n  border: none;\n  text-align: left;\n  color: var(--fg);\n  font-size: 13px;\n  padding: 8px 10px;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.shell-profile__menu-item:hover {\n  background: var(--bg);\n}\n\n.shell-profile__menu-item--danger {\n  color: var(--error);\n}\n\n.layout__sidebar-footer {\n  flex: 1;\n}\n\n/* ============ 通用 Modal ============ */\n\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 100;\n  padding: 20px;\n}\n\n.modal {\n  width: 100%;\n  max-width: 420px;\n  max-height: 90vh;\n  overflow-y: auto;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 12px;\n  padding: 20px 22px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.modal__title {\n  font-size: 16px;\n  font-weight: 700;\n}\n\n.modal__context {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin-top: -8px;\n}\n\n.modal__error {\n  background: rgba(248, 81, 73, 0.12);\n  color: var(--error);\n  border: 1px solid rgba(248, 81, 73, 0.3);\n  border-radius: 8px;\n  padding: 8px 12px;\n  font-size: 12px;\n}\n\n.modal__field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 12px;\n  color: var(--fg-muted);\n  flex: 1;\n}\n\n.modal__row {\n  display: flex;\n  gap: 10px;\n}\n\n.modal__input {\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  padding: 7px 10px;\n  font-size: 13px;\n  outline: none;\n  width: 100%;\n}\n\n.modal__input:focus {\n  border-color: var(--accent);\n}\n\n.modal__actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n  margin-top: 4px;\n}\n\n/* ============ Today V2 ============ */\n\n.page--wide {\n  max-width: 920px;\n}\n\n.today-active__head {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.today-active__name {\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.today-active__time {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin-top: 6px;\n}\n\n.today-empty,\n.review__empty {\n  text-align: center;\n  padding: 44px 20px;\n}\n\n.today-empty__title,\n.review__empty-title,\n.planning__empty-title {\n  font-size: 16px;\n  font-weight: 700;\n  margin: 0 0 8px;\n}\n\n.today-task {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.today-task--important {\n  background: rgba(79, 140, 255, 0.08);\n  border: 1px solid rgba(79, 140, 255, 0.25);\n  border-radius: 8px;\n  padding: 14px 16px;\n}\n\n.today-task__main {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 0;\n}\n\n.today-task__title {\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.today-task__path {\n  font-size: 12px;\n}\n\n.today-task__actions {\n  display: flex;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n/* ============ Planning V2 ============ */\n\n.planning__goal-switch {\n  background: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 6px 10px;\n  font-size: 13px;\n}\n\n.planning__empty {\n  max-width: 420px;\n  margin: 70px auto;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  align-items: center;\n}\n\n.planning-goal {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 16px 20px;\n  margin-bottom: 14px;\n}\n\n.planning-goal__name {\n  font-size: 17px;\n  font-weight: 700;\n}\n\n.planning-goal__desc {\n  font-size: 13px;\n  margin-top: 4px;\n}\n\n.planning-goal__side {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n.planning-goal__date {\n  font-size: 11px;\n}\n\n.planning {\n  display: flex;\n  gap: 0;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  overflow: hidden;\n  min-height: 480px;\n  background: var(--bg-elevated);\n}\n\n.planning__route {\n  width: 250px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  border-right: 1px solid var(--border);\n  background: var(--bg-sidebar);\n}\n\n.planning__route-head {\n  font-size: 12px;\n  color: var(--fg-muted);\n  padding: 12px 14px 8px;\n  letter-spacing: 1px;\n}\n\n.planning__route-body {\n  flex: 1;\n  overflow-y: auto;\n  padding: 0 8px;\n}\n\n.planning__route-empty {\n  padding: 12px;\n  font-size: 12px;\n}\n\n.planning__route-foot {\n  padding: 10px 12px;\n  border-top: 1px solid var(--border);\n}\n\n.planning__new-stage {\n  width: 100%;\n  background: transparent;\n  border: 1px dashed var(--border-strong);\n  border-radius: 8px;\n  color: var(--fg-muted);\n  font-size: 13px;\n  padding: 8px;\n  cursor: pointer;\n}\n\n.planning__new-stage:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.planning-route {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.planning-route__item {\n  position: relative;\n}\n\n.planning-route__item:not(:last-child)::after {\n  content: \"\";\n  position: absolute;\n  left: 19px;\n  top: 38px;\n  bottom: -4px;\n  width: 1px;\n  background: var(--border-strong);\n}\n\n.planning-route__btn {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  background: transparent;\n  border: none;\n  border-radius: 8px;\n  padding: 8px 8px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.planning-route__btn:hover {\n  background: var(--bg);\n}\n\n.planning-route__item--active .planning-route__btn {\n  background: rgba(79, 140, 255, 0.15);\n}\n\n.planning-route__dot {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  border: 1px solid var(--border-strong);\n  color: var(--fg-muted);\n  font-size: 11px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  background: var(--bg);\n}\n\n.planning-route__dot--done {\n  background: var(--ok);\n  border-color: var(--ok);\n  color: #fff;\n}\n\n.planning-route__info {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  min-width: 0;\n}\n\n.planning-route__name {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--fg);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.planning-route__item--done .planning-route__name {\n  color: var(--fg-muted);\n}\n\n.planning-route__item--archived .planning-route__name {\n  opacity: 0.5;\n}\n\n.planning-route__date {\n  font-size: 11px;\n  color: var(--fg-muted);\n}\n\n.planning__detail {\n  flex: 1;\n  min-width: 0;\n  padding: 18px 22px;\n  overflow-y: auto;\n}\n\n.planning__detail-empty {\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.planning-stage-head {\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--border);\n  margin-bottom: 16px;\n}\n\n.planning-stage-head__name {\n  font-size: 18px;\n  font-weight: 700;\n}\n\n.planning-stage-head__desc {\n  font-size: 13px;\n  margin-top: 4px;\n}\n\n.planning-stage-head__date {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin-top: 4px;\n}\n\n.planning-section {\n  margin-bottom: 22px;\n}\n\n.planning-section__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.planning-section__title {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--fg-muted);\n  margin: 0;\n  letter-spacing: 1px;\n}\n\n.planning-knowledge {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.planning-knowledge__item {\n  font-size: 13px;\n  padding: 7px 10px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n}\n\n.planning-plans {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.planning-plan {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 10px 14px;\n}\n\n.planning-plan--done {\n  opacity: 0.6;\n}\n\n.planning-plan__main {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.planning-plan__title {\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.planning-plan__meta {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.planning-plan__side {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n.planning-plan__menu-wrap {\n  position: relative;\n}\n\n.planning-plan__menu-btn {\n  background: transparent;\n  border: none;\n  color: var(--fg-muted);\n  font-size: 13px;\n  letter-spacing: 1px;\n  padding: 4px 8px;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.planning-plan__menu-btn:hover {\n  background: var(--bg-elevated);\n  color: var(--fg);\n}\n\n.planning-plan__backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 20;\n}\n\n.planning-plan__menu {\n  position: absolute;\n  top: 26px;\n  right: 0;\n  z-index: 21;\n  min-width: 130px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  padding: 4px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n  display: flex;\n  flex-direction: column;\n}\n\n.planning-plan__menu-item {\n  background: transparent;\n  border: none;\n  text-align: left;\n  color: var(--fg);\n  font-size: 13px;\n  padding: 7px 10px;\n  border-radius: 5px;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.planning-plan__menu-item:hover {\n  background: var(--bg);\n}\n\n.planning-plan__menu-item--danger {\n  color: var(--error);\n}\n\n.planning__hint-ok {\n  background: rgba(63, 185, 80, 0.12);\n  color: var(--ok);\n  border: 1px solid rgba(63, 185, 80, 0.3);\n  border-radius: 8px;\n  padding: 8px 14px;\n  font-size: 13px;\n  margin-bottom: 12px;\n}\n\n/* ============ Review V1 ============ */\n\n.review-agg {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.review-agg__item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 10px 14px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.review-agg__path {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.review-agg__facts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n.review-evals {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.review-evals__item {\n  display: flex;\n  gap: 18px;\n  font-size: 13px;\n  padding: 8px 14px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.review-evals__name {\n  font-weight: 600;\n  min-width: 90px;\n}\n\n.review-pending {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.review-pending__item {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 8px 14px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.review-pending__name {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.review-attention {\n  border-color: rgba(210, 153, 34, 0.4);\n}\n\n.review-attention__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 13px;\n  color: var(--warn);\n}\n\n.review-attention__note {\n  margin-top: 6px;\n  font-size: 11px;\n}\n\n.review-raw__toggle {\n  background: transparent;\n  border: none;\n  color: var(--fg-muted);\n  font-size: 13px;\n  cursor: pointer;\n  padding: 0;\n}\n\n.review-raw__toggle:hover {\n  color: var(--fg);\n}\n\n.review-raw__section {\n  margin-top: 12px;\n}\n\n.review-raw__section h3 {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin: 0 0 6px;\n}\n\n.review-raw__section ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  font-size: 12px;\n}\n\n/* ============ Progress V1 ============ */\n\n.progress-goal__name {\n  font-size: 17px;\n  font-weight: 700;\n}\n\n.progress-goal__desc {\n  margin-top: 4px;\n  font-size: 13px;\n}\n\n.progress-stage {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  margin-top: 14px;\n  font-size: 13px;\n}\n\n.progress-stage__main {\n  font-weight: 600;\n}\n\n.progress__note {\n  margin-top: 8px;\n  font-size: 11px;\n}\n\n/* ============ 1366×768 适配 ============ */\n\n@media (max-width: 1400px) {\n  .layout__main {\n    padding: 20px 24px;\n  }\n  .knowledge__tree {\n    width: 250px;\n  }\n}\n\n@media (max-height: 820px) {\n  .layout__main {\n    padding-top: 16px;\n    padding-bottom: 12px;\n  }\n  .planning {\n    min-height: 420px;\n  }\n}\n\n/* ============ DEV-0012 Evaluation Workflow ============ */\n\n/* 验证 Modal 分段选择 */\n.evmodal__seg {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.evmodal__seg-item {\n  background: var(--bg);\n  color: var(--fg-muted);\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  padding: 5px 14px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.evmodal__seg-item:hover {\n  border-color: var(--accent);\n  color: var(--fg);\n}\n\n.evmodal__seg-item--active {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\n\n.evmodal__note {\n  font-size: 13px;\n  color: var(--warn);\n  margin: 0;\n}\n\n/* 今日任务：本次学习已结束 */\n.today-justended {\n  border-color: rgba(63, 185, 80, 0.35);\n}\n\n.today-justended__title {\n  font-size: 16px;\n  font-weight: 700;\n  margin-top: 8px;\n}\n\n.today-justended__stats {\n  font-size: 12px;\n  color: var(--fg-muted);\n  margin-top: 4px;\n}\n\n.today-justended__hint {\n  margin-top: 10px;\n  background: rgba(63, 185, 80, 0.12);\n  color: var(--ok);\n  border: 1px solid rgba(63, 185, 80, 0.3);\n  border-radius: 8px;\n  padding: 7px 12px;\n  font-size: 13px;\n}\n\n/* 知识体系：记录验证入口 + 最近验证 */\n.knowledge__eval-btn {\n  background: transparent;\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  color: var(--fg-muted);\n  font-size: 11px;\n  padding: 2px 10px;\n  cursor: pointer;\n}\n\n.knowledge__eval-btn:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.knowledge__eval-btn--first {\n  font-size: 12px;\n  padding: 4px 12px;\n}\n\n.knowledge__recent-evals {\n  margin: 2px 0 10px;\n  padding: 8px 12px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.knowledge__recent-evals-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n\n.knowledge__recent-evals-title {\n  font-size: 12px;\n  color: var(--fg-muted);\n  letter-spacing: 1px;\n}\n\n.knowledge__recent-evals-empty {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n}\n\n.knowledge__recent-evals-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.knowledge__recent-evals-item {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  font-size: 12px;\n}\n\n.knowledge__recent-evals-date {\n  color: var(--fg-muted);\n  min-width: 110px;\n}\n\n.knowledge__recent-evals-type {\n  min-width: 34px;\n}\n\n.knowledge__recent-evals-outcome {\n  font-weight: 600;\n}\n\n.knowledge__recent-evals-outcome--passed {\n  color: var(--ok);\n}\n\n.knowledge__recent-evals-outcome--partial {\n  color: var(--warn);\n}\n\n.knowledge__recent-evals-outcome--failed {\n  color: var(--error);\n}\n\n.knowledge__recent-evals-outcome--unrated {\n  color: var(--fg-muted);\n}\n\n.knowledge__foot-note {\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n/* ============ DEV-0013 Feedback ============ */\n\n.review-feedback {\n  list-style: none;\n  margin: 10px 0 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.review-feedback__item {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 12px;\n  background: rgba(210, 153, 34, 0.06);\n  border: 1px solid rgba(210, 153, 34, 0.25);\n  border-radius: 8px;\n}\n\n.review-feedback__title {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.review-feedback__meta {\n  font-size: 11px;\n  text-align: right;\n}\n\n.review-flag {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.review-flag__item {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  font-size: 13px;\n  padding: 8px 14px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.review-flag__name {\n  font-weight: 600;\n  min-width: 90px;\n}\n\n.review-flag__done {\n  margin-left: auto;\n  font-size: 12px;\n  color: var(--ok);\n}\n\n.review-flag__item .btn {\n  margin-left: auto;\n}\n\n/* FeedbackCard（DEV-0014） */\n.review-feedback__item {\n  flex-wrap: wrap;\n}\n\n.review-feedback__type {\n  display: inline-block;\n  font-size: 11px;\n  color: var(--warn);\n  border: 1px solid rgba(210, 153, 34, 0.4);\n  border-radius: 999px;\n  padding: 0 8px;\n  margin-right: 8px;\n  vertical-align: 1px;\n}\n\n.review-feedback__actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n.review-feedback__hint {\n  width: 100%;\n  font-size: 12px;\n  color: var(--ok);\n}\n\n.review-feedback__hint--err {\n  color: var(--error);\n}\n\n/* ============ DEV-0015 Insight / 周期复盘 ============ */\n\n/* 复盘窗口切换 */\n.review-window {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.review-window__item {\n  background: var(--bg);\n  color: var(--fg-muted);\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  padding: 5px 14px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.review-window__item:hover {\n  border-color: var(--accent);\n  color: var(--fg);\n}\n\n.review-window__item--active {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\n\n/* 周期内解决 */\n.review-solved {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.review-solved__item {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  font-size: 13px;\n  padding: 6px 12px;\n  background: rgba(63, 185, 80, 0.06);\n  border: 1px solid rgba(63, 185, 80, 0.25);\n  border-radius: 8px;\n}\n\n/* 周期内调整（问题 → 调整 → 执行） */\n.review-adjust {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.review-adjust__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 12px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  font-size: 13px;\n}\n\n.review-adjust__chain {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.review-adjust__type {\n  font-size: 11px;\n  color: var(--accent);\n}\n\n.review-adjust__title {\n  font-weight: 500;\n}\n\n/* Progress：30 天趋势（纯 CSS 柱状，无图表库） */\n.trend {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.trend__bars {\n  display: flex;\n  align-items: flex-end;\n  gap: 2px;\n  height: 90px;\n}\n\n.trend__bar {\n  flex: 1;\n  min-width: 4px;\n  background: var(--bg-elevated);\n  border-radius: 2px 2px 0 0;\n}\n\n.trend__bar--active {\n  background: var(--accent);\n  opacity: 0.75;\n}\n\n.trend__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  font-size: 12px;\n  color: var(--fg-muted);\n}\n\n/* Progress：下一步 */\n.next-actions {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.next-actions__item {\n  display: flex;\n  align-items: baseline;\n  gap: 14px;\n  font-size: 13px;\n  padding: 8px 12px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.next-actions__date {\n  color: var(--accent);\n  font-weight: 600;\n  min-width: 46px;\n}\n\n.next-actions__title {\n  font-weight: 500;\n}\n\n.next-actions__source {\n  font-size: 11px;\n  margin-left: auto;\n  text-align: right;\n}\n\n/* ============ DEV-0016 Settings ============ */\n\n.settings-profile__name {\n  margin-bottom: 10px;\n}\n\n.settings-ai-note {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  font-size: 12px;\n  color: var(--fg-muted);\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.layout__sidebar-footer {\n  display: flex;\n  flex-direction: column;\n  padding: 10px 12px;\n  border-top: 1px solid var(--border);\n}\n\n/* ============ DEV-0017 Learning Workspace ============ */\n\n.lw__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 14px;\n}\n\n.lw__title {\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.lw__breadcrumb {\n  font-size: 12px;\n  margin-top: 2px;\n}\n\n.lw__meta {\n  font-size: 11px;\n  margin-top: 4px;\n}\n\n.lw__header-right {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  flex-shrink: 0;\n}\n\n.lw__timer {\n  font-variant-numeric: tabular-nums;\n  color: var(--fg-muted);\n  font-size: 14px;\n}\n\n.lw-editor__head {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.lw-note {\n  width: 100%;\n  min-height: 46vh;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  color: var(--fg);\n  font-size: 14px;\n  line-height: 1.7;\n  padding: 14px 16px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.lw-note:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.lw-ended__stats {\n  display: flex;\n  gap: 18px;\n  margin: 10px 0;\n  font-size: 13px;\n  color: var(--fg-muted);\n}\n\n/* ============ DEV-0024 Learning Editor V2 ============ */\n\n.leditor {\n  position: relative;\n}\n\n.leditor--drag {\n  outline: 2px dashed var(--accent);\n  outline-offset: -6px;\n  border-radius: 8px;\n}\n\n.leditor__toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n  flex-wrap: wrap;\n}\n\n.leditor__hint {\n  font-size: 11px;\n  color: var(--fg-muted);\n}\n\n.leditor__body {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.leditor__text {\n  width: 100%;\n  min-height: 72px;\n  background: var(--bg);\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: var(--fg);\n  font-size: 14px;\n  line-height: 1.75;\n  padding: 10px 12px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.leditor__text:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.leditor__media {\n  position: relative;\n}\n\n/* Word-like 图片：左对齐 / 不超正文宽 / 保持比例 / 段落间距（gap 提供） */\n.leditor__img {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  width: auto;\n  border-radius: 6px;\n  cursor: zoom-in;\n  border: 1px solid var(--border);\n}\n\n.leditor__video {\n  display: block;\n  max-width: 100%;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: #000;\n}\n\n.leditor__remove {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  background: rgba(0, 0, 0, 0.65);\n  color: #fff;\n  border: 0;\n  border-radius: 6px;\n  font-size: 11px;\n  padding: 2px 8px;\n  cursor: pointer;\n}\n\n.leditor__remove:hover {\n  background: var(--error);\n}\n\n.leditor__loading {\n  color: var(--fg-muted);\n  font-size: 12px;\n  padding: 8px 0;\n}\n\n.leditor__dropzone {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(0, 0, 0, 0.45);\n  color: #fff;\n  font-size: 14px;\n  border-radius: 8px;\n  pointer-events: none;\n}\n\n.lw-ended__review {\n  margin-top: 12px;\n  border-top: 1px solid var(--border);\n  padding-top: 12px;\n}\n\n/* Note 只读渲染（Knowledge 学习记录 / Review） */\n.noteview {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.noteview__text {\n  margin: 0;\n  white-space: pre-wrap;\n  word-break: break-word;\n  font-size: 12.5px;\n  line-height: 1.7;\n}\n\n.noteview__img {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  width: auto;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  cursor: zoom-in;\n}\n\n.noteview__video {\n  display: block;\n  max-width: 100%;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: #000;\n}\n\n/* ============ DEV-0025 Today Task Center V2 ============ */\n\n.today__filters {\n  display: flex;\n  gap: 6px;\n  margin: 8px 0 12px;\n}\n\n.chip {\n  background: transparent;\n  border: 1px solid var(--border);\n  color: var(--fg-muted);\n  border-radius: 999px;\n  font-size: 12px;\n  padding: 2px 12px;\n  cursor: pointer;\n}\n\n.chip--active {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.taskrow-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.taskrow {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 4px;\n  border-bottom: 1px solid var(--border);\n}\n\n.taskrow:last-child {\n  border-bottom: 0;\n}\n\n.taskrow__check {\n  background: none;\n  border: 0;\n  font-size: 20px;\n  line-height: 1;\n  cursor: pointer;\n  color: var(--fg-muted);\n  padding: 2px 6px;\n}\n\n.taskrow__check:hover {\n  color: var(--accent);\n}\n\n.taskrow--done .taskrow__check {\n  color: var(--accent);\n}\n\n.taskrow__main {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  flex: 1;\n}\n\n.taskrow__title {\n  font-size: 14px;\n}\n\n.taskrow--done .taskrow__title {\n  color: var(--fg-muted);\n  text-decoration: line-through;\n}\n\n.taskrow__meta {\n  font-size: 11.5px;\n  color: var(--fg-muted);\n}\n\n.taskrow__actions {\n  display: flex;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n/* TaskModal 知识选择器 */\n.taskmodal__picker {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  margin-bottom: 6px;\n}\n\n.taskmodal__search {\n  flex: 1;\n}\n\n.taskmodal__list {\n  max-height: 160px;\n  overflow-y: auto;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 6px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 10px;\n}\n\n.taskmodal__item {\n  background: var(--bg);\n  border: 1px solid var(--border);\n  color: var(--fg);\n  border-radius: 999px;\n  font-size: 12px;\n  padding: 2px 10px;\n  cursor: pointer;\n}\n\n.taskmodal__item--active {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.taskmodal__quick {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  margin-bottom: 10px;\n  flex-wrap: wrap;\n}\n\n.taskmodal__daterow {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n}\n\n/* ============ DEV-0026 Planning Calendar ============ */\n\n.pcal__bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 10px;\n}\n\n.pcal__nav {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.pcal__title {\n  font-size: 16px;\n  font-weight: 700;\n  min-width: 110px;\n  text-align: center;\n}\n\n.pcal__rules {\n  margin-bottom: 10px;\n}\n\n.pcal__rule-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.pcal__rule {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 2px;\n  border-bottom: 1px solid var(--border);\n}\n\n.pcal__rule:last-child {\n  border-bottom: 0;\n}\n\n.pcal__rule--off .pcal__rule-title {\n  color: var(--fg-muted);\n  text-decoration: line-through;\n}\n\n.pcal__rule-main {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  flex: 1;\n  min-width: 0;\n}\n\n.pcal__rule-title {\n  font-size: 13px;\n}\n\n.pcal__rule-actions {\n  display: flex;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n.pcal__grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 4px;\n}\n\n.pcal__weekday {\n  text-align: center;\n  font-size: 11px;\n  color: var(--fg-muted);\n  padding: 4px 0;\n}\n\n.pcal__cell {\n  min-height: 84px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 6px 8px;\n  cursor: pointer;\n  text-align: left;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  color: var(--fg);\n  overflow: hidden;\n}\n\n.pcal__cell--empty {\n  background: transparent;\n  border-color: transparent;\n  cursor: default;\n}\n\n.pcal__cell--today {\n  border-color: var(--accent);\n}\n\n.pcal__cell--has:hover {\n  border-color: var(--accent);\n}\n\n.pcal__date {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.pcal__cell--today .pcal__date {\n  color: var(--accent);\n}\n\n.pcal__count {\n  font-size: 10.5px;\n  color: var(--accent);\n}\n\n.pcal__tasks {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  overflow: hidden;\n}\n\n.pcal__task {\n  font-size: 10.5px;\n  color: var(--fg-muted);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.pcal__task--done {\n  text-decoration: line-through;\n}\n\n.pcal__more {\n  font-size: 10px;\n  color: var(--fg-muted);\n}\n\n/* ============ DEV-0027 Review V2 ============ */\n\n.rv-stats-line {\n  margin: 0;\n  font-size: 12.5px;\n}\n\n.rlearn {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.rlearn__card {\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 12px 14px;\n}\n\n.rlearn__head {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.rlearn__name {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.rlearn__facts {\n  font-size: 12px;\n}\n\n.rlearn__note {\n  margin: 8px 0;\n  padding: 8px 12px;\n  border-left: 3px solid var(--accent);\n  background: var(--bg);\n  border-radius: 6px;\n  font-size: 12.5px;\n  line-height: 1.7;\n  color: var(--fg);\n}\n\n.rlearn__actions {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.rv-fullnote {\n  max-height: 60vh;\n  overflow-y: auto;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px;\n  background: var(--bg);\n  margin: 8px 0;\n}\n\n/* ============ DEV-0028 Knowledge V2 ============ */\n\n.knowledge__mine-label {\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--accent);\n  margin: 14px 0 -6px;\n  letter-spacing: 0.5px;\n}\n\n.knowledge-evidence {\n  margin-top: 12px;\n  border-top: 1px dashed var(--border);\n  padding-top: 10px;\n}\n\n.knowledge-evidence summary {\n  cursor: pointer;\n  font-size: 12.5px;\n  color: var(--fg-muted);\n  user-select: none;\n}\n\n.knowledge-evidence summary:hover {\n  color: var(--fg);\n}\n\n.knowledge-evidence[open] summary {\n  margin-bottom: 8px;\n}\n\n/* Knowledge Graph V2：选中操作栏 + 节点菜单 */\n.kgraph__bar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin-