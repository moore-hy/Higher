n\r\n.badge--done {\r\n  background: rgba(63, 185, 80, 0.18);\r\n  color: var(--ok);\r\n}\r\n\r\n/* ============ 通用辅助 ============ */\r\n\r\n.muted {\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.alert {\r\n  padding: 10px 14px;\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n.alert--error {\r\n  background: rgba(248, 81, 73, 0.12);\r\n  color: var(--error);\r\n  border: 1px solid rgba(248, 81, 73, 0.3);\r\n}\r\n\r\n/* ============ Today: Active Session ============ */\r\n\r\n.active-session {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.active-session__main {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.active-session__item {\r\n  font-weight: 600;\r\n}\r\n\r\n.active-session__task {\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.active-session__time {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.active-session__end-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.start-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n/* ============ 列表 ============ */\r\n\r\n.task-list,\r\n.session-list,\r\n.goal-list,\r\n.item-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.task-list__item,\r\n.session-list__item,\r\n.goal-list__item,\r\n.item-list__item {\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 12px 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.task-list__item--done {\r\n  opacity: 0.55;\r\n}\r\n\r\n.task-list__item {\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.task-list__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.task-list__title {\r\n  font-weight: 500;\r\n}\r\n\r\n.task-list__meta {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.task-list__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.session-list__head,\r\n.goal-list__head,\r\n.item-list__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.session-list__item-name,\r\n.goal-list__name,\r\n.item-list__name {\r\n  font-weight: 600;\r\n}\r\n\r\n.session-list__time,\r\n.goal-list__time,\r\n.item-list__time {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.goal-list__actions {\r\n  margin-top: 4px;\r\n}\r\n\r\n/* ============ Learning Structure Tree ============ */\r\n\r\n.tree,\r\n.tree-children {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.tree {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.tree-children {\r\n  margin-top: 4px;\r\n}\r\n\r\n.tree-node {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.tree-node__row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 8px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  min-height: 36px;\r\n}\r\n\r\n.tree-node__toggle {\r\n  width: 18px;\r\n  height: 18px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--fg-muted);\r\n  cursor: pointer;\r\n  font-size: 12px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.tree-node__toggle:hover {\r\n  color: var(--fg);\r\n}\r\n\r\n.tree-node__toggle--leaf {\r\n  cursor: default;\r\n}\r\n\r\n.tree-node__name {\r\n  font-weight: 500;\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.tree-node__desc {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  padding: 2px 12px 4px;\r\n}\r\n\r\n.tree-node__path {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  opacity: 0.8;\r\n  padding: 0 12px 2px;\r\n}\r\n\r\n.tree-node__time {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  opacity: 0.7;\r\n  padding: 0 12px 6px;\r\n}\r\n\r\n.tree-node__add-child {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  padding: 8px 12px;\r\n  background: var(--bg-elevated);\r\n  border: 1px dashed var(--border-strong);\r\n  border-radius: 6px;\r\n  margin: 4px 0;\r\n}\r\n\r\n.session-list__note,\r\n.goal-list__desc,\r\n.item-list__desc {\r\n  font-size: 13px;\r\n  color: var(--fg);\r\n}\r\n\r\n.item-list__status-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n.item-list__goal {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ============ History: Stats ============ */\r\n\r\n.stats-row {\r\n  display: flex;\r\n  gap: 24px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.stat {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.stat__label {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.stat__value {\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  color: var(--accent);\r\n}\r\n\r\n/* ============ Profile Gate ============ */\r\n\r\n.profile-gate {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 100vh;\r\n  padding: 40px 20px;\r\n  gap: 24px;\r\n}\r\n\r\n.profile-gate__loading {\r\n  color: var(--fg-muted);\r\n  font-size: 15px;\r\n}\r\n\r\n.profile-gate__card {\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border);\r\n  border-radius: 16px;\r\n  padding: 48px 40px;\r\n  text-align: center;\r\n  max-width: 480px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.profile-gate__header {\r\n  text-align: center;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.profile-gate__title {\r\n  font-size: 28px;\r\n  font-weight: 700;\r\n  margin: 0;\r\n}\r\n\r\n.profile-gate__subtitle {\r\n  font-size: 16px;\r\n  color: var(--accent);\r\n  margin: 0;\r\n}\r\n\r\n.profile-gate__desc {\r\n  font-size: 14px;\r\n  color: var(--fg-muted);\r\n  line-height: 1.6;\r\n  margin: 0;\r\n}\r\n\r\n.profile-gate__btn {\r\n  margin-top: 8px;\r\n  padding: 10px 32px;\r\n  font-size: 15px;\r\n}\r\n\r\n.profile-gate__error {\r\n  background: rgba(248, 81, 73, 0.12);\r\n  color: var(--error);\r\n  border: 1px solid rgba(248, 81, 73, 0.3);\r\n  padding: 10px 16px;\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n  max-width: 480px;\r\n  text-align: center;\r\n}\r\n\r\n/* ============ Profile Selector ============ */\r\n\r\n.profile-selector__list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  width: 100%;\r\n  max-width: 480px;\r\n}\r\n\r\n.profile-card {\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 20px 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.profile-card__name {\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n}\r\n\r\n.profile-card__type {\r\n  font-size: 13px;\r\n  color: var(--accent);\r\n}\r\n\r\n.profile-card__meta {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.profile-card__desc {\r\n  font-size: 13px;\r\n  color: var(--fg);\r\n  margin-top: 4px;\r\n}\r\n\r\n.profile-card .btn {\r\n  align-self: flex-start;\r\n  margin-top: 8px;\r\n}\r\n\r\n/* ============ Profile Create Form ============ */\r\n\r\n.profile-create__form {\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 28px 32px;\r\n  width: 100%;\r\n  max-width: 480px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n\r\n.form-label {\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n  display: block;\r\n}\r\n\r\n.form-input {\r\n  width: 100%;\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 6px;\r\n  padding: 8px 12px;\r\n  font-size: 14px;\r\n  outline: none;\r\n}\r\n\r\n.form-input:focus {\r\n  border-color: var(--accent);\r\n}\r\n\r\n/* ============ Layout: Profile Header ============ */\r\n\r\n.layout__profile {\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.layout__profile-label {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.layout__profile-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 100%;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 6px;\r\n  padding: 8px 12px;\r\n  color: var(--fg);\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n}\r\n\r\n.layout__profile-btn:hover {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.layout__profile-name {\r\n  flex: 1;\r\n  text-align: left;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.layout__profile-arrow {\r\n  font-size: 10px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.layout__profile-menu {\r\n  margin-top: 4px;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 6px;\r\n  overflow: hidden;\r\n}\r\n\r\n.layout__profile-menu-item {\r\n  display: block;\r\n  width: 100%;\r\n  text-align: left;\r\n  background: transparent;\r\n  border: none;\r\n  padding: 8px 12px;\r\n  color: var(--fg);\r\n  font-size: 13px;\r\n}\r\n\r\n.layout__profile-menu-item:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.layout__error {\r\n  margin: 8px 16px;\r\n  padding: 8px 12px;\r\n  background: rgba(248, 81, 73, 0.12);\r\n  color: var(--error);\r\n  border: 1px solid rgba(248, 81, 73, 0.3);\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n}\r\n\r\n/* ============ Profile Calendar ============ */\r\n\r\n.calendar__header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.calendar__header .card__title {\r\n  margin: 0;\r\n}\r\n\r\n.calendar__nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.calendar__month-label {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  min-width: 90px;\r\n  text-align: center;\r\n}\r\n\r\n.calendar__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(7, 1fr);\r\n  gap: 6px;\r\n}\r\n\r\n.calendar__grid--head {\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.calendar__weekday {\r\n  text-align: center;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  padding: 2px 0;\r\n}\r\n\r\n.calendar__cell {\r\n  min-height: 64px;\r\n  border-radius: 6px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  padding: 4px 6px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  font-size: 11px;\r\n  text-align: left;\r\n}\r\n\r\n.calendar__cell--blank {\r\n  background: transparent;\r\n  border-color: transparent;\r\n}\r\n\r\nbutton.calendar__cell--day {\r\n  cursor: pointer;\r\n  color: var(--fg);\r\n}\r\n\r\nbutton.calendar__cell--day:hover {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.calendar__cell--today {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.calendar__cell--selected {\r\n  border-color: var(--accent);\r\n  box-shadow: 0 0 0 1px var(--accent);\r\n}\r\n\r\n/* 活动强度：只表示活动量，不代表学习效果 */\r\n.calendar__cell--level1 {\r\n  background: rgba(79, 140, 255, 0.10);\r\n}\r\n\r\n.calendar__cell--level2 {\r\n  background: rgba(79, 140, 255, 0.22);\r\n}\r\n\r\n.calendar__cell--level3 {\r\n  background: rgba(79, 140, 255, 0.34);\r\n}\r\n\r\n.calendar__day-num {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.calendar__day-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  color: var(--fg-muted);\r\n  font-size: 10px;\r\n  line-height: 1.3;\r\n  overflow: hidden;\r\n}\r\n\r\n.calendar__day-line {\r\n  white-space: nowrap;\r\n}\r\n\r\n.calendar__detail {\r\n  margin-top: 12px;\r\n  padding-top: 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.calendar__detail-title {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.calendar__detail-stats {\r\n  display: flex;\r\n  gap: 32px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.calendar__detail-stats .stat__value {\r\n  font-size: 18px;\r\n}\r\n\r\n/* ============ Knowledge Workspace（知识体系工作区） ============ */\r\n\r\n/* 工作区占满视口、自己管理滚动（仅当渲染 .knowledge 时覆盖默认 main padding） */\r\n.layout__main:has(> .knowledge) {\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.knowledge {\r\n  display: flex;\r\n  height: 100%;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n/* ---- 左侧：知识树 ---- */\r\n\r\n.knowledge__tree {\r\n  width: 280px;\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  border-right: 1px solid var(--border);\r\n  background: var(--bg-sidebar);\r\n  min-height: 0;\r\n}\r\n\r\n.knowledge__goal {\r\n  padding: 10px 12px 4px;\r\n}\r\n\r\n.knowledge__goal-label {\r\n  display: block;\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.knowledge__goal-select {\r\n  width: 100%;\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  padding: 6px 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n.knowledge__search {\r\n  padding: 10px 12px;\r\n}\r\n\r\n.knowledge__search-input {\r\n  width: 100%;\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  padding: 7px 10px;\r\n  font-size: 13px;\r\n  outline: none;\r\n}\r\n\r\n.knowledge__search-input:focus {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.knowledge__tree-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 4px 8px;\r\n  min-height: 0;\r\n}\r\n\r\n.knowledge__hint {\r\n  padding: 8px;\r\n}\r\n\r\n.knowledge__tree-empty {\r\n  padding: 20px 12px;\r\n}\r\n\r\n.knowledge__empty-title {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  margin: 0 0 6px;\r\n}\r\n\r\n/* 搜索结果（平铺 + 路径提示） */\r\n.knowledge__search-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.knowledge__search-item {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  width: 100%;\r\n  text-align: left;\r\n  background: transparent;\r\n  border: none;\r\n  border-radius: 6px;\r\n  padding: 6px 10px;\r\n  cursor: pointer;\r\n  color: var(--fg);\r\n}\r\n\r\n.knowledge__search-item:hover {\r\n  background: var(--bg-elevated);\r\n}\r\n\r\n.knowledge__search-item--active {\r\n  background: rgba(79, 140, 255, 0.15);\r\n}\r\n\r\n.knowledge__search-name {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n\r\n.knowledge__search-path {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* 树节点 */\r\n.knowledge__nodes {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n}\r\n\r\n.knowledge__nodes--child {\r\n  padding-left: 14px;\r\n  border-left: 1px solid var(--border);\r\n  margin-left: 13px;\r\n}\r\n\r\n.knowledge__node-row {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  border-radius: 6px;\r\n  padding: 1px 2px;\r\n  min-height: 30px;\r\n}\r\n\r\n.knowledge__node-row:hover {\r\n  background: var(--bg-elevated);\r\n}\r\n\r\n.knowledge__node-row--active {\r\n  background: rgba(79, 140, 255, 0.18);\r\n}\r\n\r\n.knowledge__node-toggle {\r\n  width: 22px;\r\n  height: 24px;\r\n  flex-shrink: 0;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--fg-muted);\r\n  font-size: 11px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__node-toggle--leaf {\r\n  cursor: default;\r\n  color: var(--border-strong);\r\n}\r\n\r\n.knowledge__node-name {\r\n  flex: 1;\r\n  min-width: 0;\r\n  text-align: left;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--fg);\r\n  font-size: 13px;\r\n  padding: 4px 2px;\r\n  cursor: pointer;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.knowledge__node-menu-btn {\r\n  flex-shrink: 0;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  letter-spacing: 1px;\r\n  padding: 4px 6px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  opacity: 0;\r\n}\r\n\r\n.knowledge__node-row:hover .knowledge__node-menu-btn {\r\n  opacity: 1;\r\n}\r\n\r\n.knowledge__node-menu-btn:hover {\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n}\r\n\r\n/* 节点 ··· 菜单 */\r\n.knowledge__menu-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 10;\r\n}\r\n\r\n.knowledge__menu {\r\n  position: absolute;\r\n  top: 28px;\r\n  right: 4px;\r\n  z-index: 11;\r\n  min-width: 120px;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  padding: 4px;\r\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.knowledge__menu-item {\r\n  background: transparent;\r\n  border: none;\r\n  text-align: left;\r\n  color: var(--fg);\r\n  font-size: 13px;\r\n  padding: 7px 10px;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__menu-item:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.knowledge__menu-item--danger {\r\n  color: var(--error);\r\n}\r\n\r\n/* 内联新建 / 重命名输入框 */\r\n.knowledge__new-input {\r\n  width: 100%;\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n  border: 1px solid var(--accent);\r\n  border-radius: 6px;\r\n  padding: 6px 10px;\r\n  font-size: 13px;\r\n  outline: none;\r\n}\r\n\r\n.knowledge__new-input--inline {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.knowledge__add-child {\r\n  padding: 4px 4px 4px 16px;\r\n  margin-left: 13px;\r\n}\r\n\r\n.knowledge__tree-footer {\r\n  padding: 10px 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.knowledge__new-root {\r\n  width: 100%;\r\n  background: transparent;\r\n  border: 1px dashed var(--border-strong);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 13px;\r\n  padding: 8px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__new-root:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n/* ---- 右侧：知识编辑器 ---- */\r\n\r\n.knowledge__main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 16px 24px 12px;\r\n  position: relative;\r\n  min-height: 0;\r\n}\r\n\r\n.knowledge__editor-empty {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.knowledge__breadcrumb {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 6px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.knowledge__title-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.knowledge__title {\r\n  flex: 1;\r\n  min-width: 0;\r\n  background: transparent;\r\n  border: none;\r\n  border-bottom: 1px solid transparent;\r\n  color: var(--fg);\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  padding: 2px 0;\r\n  outline: none;\r\n}\r\n\r\n.knowledge__title:hover {\r\n  border-bottom-color: var(--border);\r\n}\r\n\r\n.knowledge__title:focus {\r\n  border-bottom-color: var(--accent);\r\n}\r\n\r\n.knowledge__mastery {\r\n  flex-shrink: 0;\r\n  background: var(--bg);\r\n  color: var(--fg-muted);\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  padding: 3px 10px;\r\n  outline: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__stats {\r\n  display: flex;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  margin: 6px 0 10px;\r\n}\r\n\r\n.knowledge__content {\r\n  flex: 1;\r\n  width: 100%;\r\n  min-height: 60vh;\r\n  resize: none;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--fg);\r\n  font-size: 14px;\r\n  line-height: 1.75;\r\n  font-family: inherit;\r\n  outline: none;\r\n  padding: 0;\r\n}\r\n\r\n.knowledge__content::placeholder {\r\n  color: var(--fg-muted);\r\n  opacity: 0.7;\r\n}\r\n\r\n.knowledge__editor-foot {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n  min-height: 36px;\r\n}\r\n\r\n.knowledge__save-status {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.knowledge__save-status--saving {\r\n  color: var(--warn);\r\n}\r\n\r\n.knowledge__save-status--saved {\r\n  color: var(--ok);\r\n}\r\n\r\n.knowledge__save-status--error {\r\n  color: var(--error);\r\n}\r\n\r\n.knowledge__retry {\r\n  background: transparent;\r\n  border: 1px solid var(--error);\r\n  border-radius: 4px;\r\n  color: var(--error);\r\n  font-size: 11px;\r\n  padding: 1px 8px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__error {\r\n  position: absolute;\r\n  bottom: 48px;\r\n  left: 24px;\r\n  right: 24px;\r\n  background: rgba(248, 81, 73, 0.12);\r\n  color: var(--error);\r\n  border: 1px solid rgba(248, 81, 73, 0.3);\r\n  border-radius: 8px;\r\n  padding: 8px 12px;\r\n  font-size: 12px;\r\n}\r\n\r\n/* 无 Goal / 空状态 */\r\n.knowledge__empty {\r\n  max-width: 420px;\r\n  margin: 80px auto;\r\n  text-align: center;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n\r\n/* ============ V2 Shell：档案区 ============ */\r\n\r\n.shell-profile {\r\n  position: relative;\r\n  padding: 0 8px;\r\n}\r\n\r\n.shell-profile__btn {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 2px;\r\n  width: 100%;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 10px 12px;\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.shell-profile__btn:hover {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.shell-profile__name {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--fg);\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.shell-profile__sub {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.shell-profile__arrow {\r\n  position: absolute;\r\n  top: 12px;\r\n  right: 16px;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.shell-profile__backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 30;\r\n}\r\n\r\n.shell-profile__menu {\r\n  position: absolute;\r\n  top: calc(100% + 4px);\r\n  left: 8px;\r\n  right: 8px;\r\n  z-index: 31;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 10px;\r\n  padding: 4px;\r\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.shell-profile__menu-item {\r\n  background: transparent;\r\n  border: none;\r\n  text-align: left;\r\n  color: var(--fg);\r\n  font-size: 13px;\r\n  padding: 8px 10px;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n}\r\n\r\n.shell-profile__menu-item:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.shell-profile__menu-item--danger {\r\n  color: var(--error);\r\n}\r\n\r\n.layout__sidebar-footer {\r\n  flex: 1;\r\n}\r\n\r\n/* ============ 通用 Modal ============ */\r\n\r\n.modal-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 100;\r\n  padding: 20px;\r\n}\r\n\r\n.modal {\r\n  width: 100%;\r\n  max-width: 420px;\r\n  max-height: 90vh;\r\n  overflow-y: auto;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 12px;\r\n  padding: 20px 22px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n.modal__title {\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n}\r\n\r\n.modal__context {\r\n  font-size: 12px;\r