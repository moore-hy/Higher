kground: var(--bg);\r\n}\r\n\r\n.kgraph__menu-danger {\r\n  color: var(--error) !important;\r\n}\r\n\r\n/* ============ DEV-0029 Progress V2 ============ */\r\n\r\n.donuts {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\r\n  gap: 16px 12px;\r\n}\r\n\r\n.donut {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 4px;\r\n  text-align: center;\r\n}\r\n\r\n.donut__title {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.donut__sub {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.p30table-wrap {\r\n  overflow-x: auto;\r\n}\r\n\r\n.p30table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.p30table th {\r\n  text-align: left;\r\n  color: var(--fg-muted);\r\n  font-weight: 500;\r\n  font-size: 11.5px;\r\n  padding: 6px 10px;\r\n  border-bottom: 1px solid var(--border-strong);\r\n}\r\n\r\n.p30table td {\r\n  padding: 6px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.p30table__row {\r\n  cursor: pointer;\r\n}\r\n\r\n.p30table__row:hover td {\r\n  background: var(--bg);\r\n}\r\n\r\n/* ============ DEV-0030 数据管理 ============ */\r\n\r\n.cleanup-list {\r\n  list-style: none;\r\n  margin: 12px 0 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.cleanup-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px 2px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.cleanup-item:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.cleanup-item--danger .cleanup-item__label {\r\n  color: var(--error);\r\n}\r\n\r\n.cleanup-item__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  flex: 1;\r\n}\r\n\r\n.cleanup-item__label {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.cleanup-item__desc {\r\n  font-size: 11.5px;\r\n}\r\n\r\n.cleanup-preview {\r\n  margin: 6px 0;\r\n  padding-left: 18px;\r\n  font-size: 12.5px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n/* ============ DEV-0031 Today Quick Task ============ */\r\n\r\n.today-head {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n\r\n.today-head__sub {\r\n  margin: 2px 0 0;\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ⋯ 菜单（任务行） */\r\n.taskmenu {\r\n  position: relative;\r\n}\r\n\r\n.taskmenu__btn {\r\n  background: transparent;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 13px;\r\n  padding: 1px 9px;\r\n  cursor: pointer;\r\n  line-height: 1.5;\r\n}\r\n\r\n.taskmenu__btn:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.taskmenu__pop {\r\n  position: absolute;\r\n  right: 0;\r\n  top: 28px;\r\n  z-index: 30;\r\n  min-width: 130px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  padding: 4px;\r\n  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.taskmenu__pop button {\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--fg);\r\n  text-align: left;\r\n  font-size: 12.5px;\r\n  padding: 6px 10px;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n}\r\n\r\n.taskmenu__pop button:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.taskmenu__danger {\r\n  color: var(--error) !important;\r\n}\r\n\r\n/* AI 一行 */\r\n.today-ai-line {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 8px 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* 轻量 Toast */\r\n.toast {\r\n  position: fixed;\r\n  bottom: 26px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  z-index: 200;\r\n  padding: 8px 18px;\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.toast--ok {\r\n  background: rgba(63, 185, 80, 0.92);\r\n  color: #fff;\r\n}\r\n\r\n/* Quick Modal（第一屏只有标题+日期） */\r\n.modal--quick {\r\n  max-width: 420px;\r\n}\r\n\r\n.taskmodal__name {\r\n  font-size: 15px;\r\n}\r\n\r\n.taskmodal__more-toggle {\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--accent);\r\n  font-size: 12px;\r\n  padding: 6px 2px;\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.taskmodal__more-toggle:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.taskmodal__more {\r\n  border-top: 1px dashed var(--border);\r\n  margin-top: 6px;\r\n  padding-top: 10px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.taskmodal__field-label {\r\n  display: block;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n/* ============ DEV-0032 Planning ============ */\r\n\r\n.planning-head-line {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  flex-wrap: wrap;\r\n  padding: 8px 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  margin-bottom: 10px;\r\n  font-size: 13px;\r\n}\r\n\r\n.planning-head-line__goal {\r\n  font-weight: 700;\r\n  font-size: 14px;\r\n}\r\n\r\n.planning-stage-head__actions {\r\n  margin-left: auto;\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n/* ============ DEV-0033 Review Timeline ============ */\r\n\r\n.rtimeline {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.rtimeline__item {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 12px;\r\n  padding: 9px 2px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.rtimeline__item:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.rtimeline__time {\r\n  flex-shrink: 0;\r\n  width: 118px;\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.rtimeline__mark {\r\n  flex-shrink: 0;\r\n  width: 16px;\r\n  text-align: center;\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.rtimeline__mark--study {\r\n  color: var(--accent);\r\n}\r\n\r\n.rtimeline__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  min-width: 0;\r\n}\r\n\r\n.rtimeline__title {\r\n  font-size: 13.5px;\r\n}\r\n\r\n.rtimeline__note {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 640px;\r\n}\r\n\r\n/* ============ DEV-0034 Knowledge Graph V2 ============ */\r\n\r\n.kgraph__info {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  margin: 0 0 10px;\r\n  padding: 6px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--bg);\r\n}\r\n\r\n.kgraph__info-name {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.kgraph__canvas {\r\n  overflow: auto;\r\n  max-height: calc(100vh - 300px);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--bg);\r\n  padding: 10px;\r\n}\r\n\r\n/* ============ DEV-0035 Progress ============ */\r\n\r\n.progress__facts {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  margin-top: 10px;\r\n  font-size: 12.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.recent-learn {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.recent-learn__item {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 14px;\r\n  padding: 8px 2px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.recent-learn__item:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.recent-learn__day {\r\n  width: 52px;\r\n  flex-shrink: 0;\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.recent-learn__name {\r\n  font-size: 13.5px;\r\n}\r\n\r\n/* ============ DEV-0036 数据管理 ============ */\r\n\r\n.cleanup-archived {\r\n  margin-top: 14px;\r\n}\r\n\r\n.cleanup-archived__body {\r\n  margin-top: 8px;\r\n  border-top: 1px dashed var(--border);\r\n  padding-top: 10px;\r\n}\r\n\r\n.cleanup-backups {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ============ DEV-0301 日期详情抽屉 / DEV-0305 知识树 ============ */\r\n\r\n.today-head__btns {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.daydrawer {\r\n  max-width: 640px;\r\n  max-height: 82vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n.daydrawer__sec {\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.daydrawer__sec-title {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.daydrawer__sessions {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.daydrawer__session {\r\n  display: flex;\r\n  gap: 12px;\r\n  padding: 8px 0;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.daydrawer__session:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.daydrawer__time {\r\n  flex-shrink: 0;\r\n  width: 110px;\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.daydrawer__session-main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  min-width: 0;\r\n}\r\n\r\n.daydrawer__session-title {\r\n  font-size: 13px;\r\n}\r\n\r\n.daydrawer__note {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n}\r\n\r\n.recent-learn__link {\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--fg);\r\n  font-size: 13.5px;\r\n  padding: 0;\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.recent-learn__link:hover:not(:disabled) {\r\n  color: var(--accent);\r\n}\r\n\r\n.recent-learn__link:disabled {\r\n  color: var(--fg-muted);\r\n  cursor: default;\r\n}\r\n\r\n/* 知识树：拖拽与排序（DEV-0305） */\r\n.knowledge__node--drop > .knowledge__node-row {\r\n  outline: 2px dashed var(--accent);\r\n  outline-offset: -2px;\r\n}\r\n\r\n.knowledge__node-row[draggable=\"true\"] {\r\n  cursor: grab;\r\n}\r\n\r\n.knowledge__node-order {\r\n  display: inline-flex;\r\n  gap: 2px;\r\n  opacity: 0;\r\n  transition: opacity 0.12s;\r\n}\r\n\r\n.knowledge__node-row:hover .knowledge__node-order {\r\n  opacity: 1;\r\n}\r\n\r\n.knowledge__node-arrow {\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 4px;\r\n  color: var(--fg-muted);\r\n  font-size: 10px;\r\n  line-height: 1;\r\n  padding: 1px 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__node-arrow:hover:not(:disabled) {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.knowledge__node-arrow:disabled {\r\n  opacity: 0.3;\r\n  cursor: default;\r\n}\r\n\r\n.lw-att__head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* 学习记录（Knowledge） */\r\n.k-sessions {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.k-sessions__item {\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.k-sessions__head {\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--fg);\r\n  padding: 8px 12px;\r\n  cursor: pointer;\r\n  font-size: 12px;\r\n  text-align: left;\r\n}\r\n\r\n.k-sessions__arrow {\r\n  margin-left: auto;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.k-sessions__body {\r\n  padding: 4px 12px 10px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.k-sessions__note {\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  font-size: 12px;\r\n  margin: 8px 0 0;\r\n  color: var(--fg);\r\n  max-height: 240px;\r\n  overflow: auto;\r\n}\r\n\r\n.knowledge__viewbar {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.knowledge__ai-check {\r\n  margin: 8px 0;\r\n  padding: 10px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n/* 知识图 */\r\n.kgraph {\r\n  overflow: auto;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--bg);\r\n  padding: 16px;\r\n}\r\n\r\n/* ============ DEV-0018 附件 ============ */\r\n\r\n.att-grid {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.att-tile {\r\n  width: 150px;\r\n}\r\n\r\n.att-thumb,\r\n.att-filecard {\r\n  width: 150px;\r\n  height: 100px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: var(--bg);\r\n}\r\n\r\n.att-thumb {\r\n  padding: 0;\r\n  cursor: zoom-in;\r\n}\r\n\r\n.att-thumb img {\r\n  max-width: 100%;\r\n  max-height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n.att-thumb--loading {\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.att-filecard {\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.att-filecard__type {\r\n  font-size: 22px;\r\n}\r\n\r\n.att-filecard__name {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  max-width: 130px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.att-tile__meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin-top: 4px;\r\n  font-size: 11px;\r\n}\r\n\r\n.att-tile__meta .muted {\r\n  max-width: 80px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.att-tile__err {\r\n  font-size: 11px;\r\n  color: var(--error);\r\n}\r\n\r\n.att-fullview {\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 10px;\r\n  padding: 14px;\r\n  max-width: 86vw;\r\n  max-height: 84vh;\r\n  overflow: auto;\r\n}\r\n\r\n.att-fullview img {\r\n  max-width: 80vw;\r\n  max-height: 70vh;\r\n  object-fit: contain;\r\n}\r\n\r\n/* 视频内嵌播放（DEV-0022：HTML5 video，不启动外部程序） */\r\n.att-video {\r\n  width: 150px;\r\n  height: 100px;\r\n  background: #000;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n\r\n/* 画图 */\r\n.draw__toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.draw__canvas {\r\n  width: 100%;\r\n  background: #1e1e22;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  touch-action: none;\r\n  cursor: crosshair;\r\n}\r\n\r\n/* ============ DEV-0019/20/21 AI ============ */\r\n\r\n.ai-report__block {\r\n  margin-top: 10px;\r\n}\r\n\r\n.ai-report__block-title {\r\n  font-size: 12px;\r\n  color: var(--accent);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.ai-report__block ul {\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  font-size: 13px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n}\r\n\r\n.ai-report__usage {\r\n  margin-top: 10px;\r\n  font-size: 11px;\r\n}\r\n\r\n.ai-suggest {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.ai-suggest__item {\r\n  padding: 10px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n\r\n.ai-suggest__main {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 10px;\r\n}\r\n\r\n.ai-suggest__title {\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.ai-suggest__reason {\r\n  font-size: 12px;\r\n  margin-top: 4px;\r\n}\r\n\r\n/* Proposal Diff */\r\n.prop-op {\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 10px 12px;\r\n  margin: 10px 0;\r\n}\r\n\r\n.prop-op__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.prop-op__badge {\r\n  font-size: 11px;\r\n  border: 1px solid var(--accent);\r\n  color: var(--accent);\r\n  border-radius: 999px;\r\n  padding: 0 8px;\r\n}\r\n\r\n.prop-op__reason {\r\n  font-size: 12px;\r\n  margin: 6px 0;\r\n}\r\n\r\n.prop-diff {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 10px;\r\n}\r\n\r\n.prop-diff__label {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.prop-diff__pre {\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  padding: 8px 10px;\r\n  font-size: 12px;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  max-height: 220px;\r\n  overflow: auto;\r\n  margin: 0;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.prop-diff__edit {\r\n  width: 100%;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  font-size: 12px;\r\n  padding: 8px 10px;\r\n  font-family: inherit;\r\n  resize: vertical;\r\n}\r\n\r\n.prop-diff__edit:focus {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .prop-diff {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* ============ DEV-0041 Responsive Shell（§26-31） ============ */\r\n\r\n/* ---- 防挤压基础（所有断点生效；内容本身不横向溢出，不依赖 overflow-x:hidden） ---- */\r\n\r\n.layout__main {\r\n  min-width: 0;\r\n}\r\n\r\n.page {\r\n  min-width: 0;\r\n}\r\n\r\n/* Modal：宽度上限与视口挂钩，超高内部滚动（不出界） */\r\n.modal {\r\n  max-width: min(92vw, 420px);\r\n}\r\n\r\n.modal--quick {\r\n  max-width: min(92vw, 420px);\r\n}\r\n\r\n.modal--wide,\r\n.daydrawer {\r\n  max-width: min(94vw, 640px);\r\n  max-height: 88vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* grid 单元允许收缩（防 768px 溢出） */\r\n.pcal__grid,\r\n.calendar__grid {\r\n  grid-template-columns: repeat(7, minmax(0, 1fr));\r\n}\r\n\r\n.taskmodal__daterow,\r\n.prop-diff {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n/* 品牌图标（Rail 模式显示 H；全宽模式显示全名） */\r\n.layout__brand-mark {\r\n  display: none;\r\n  min-width: 28px;\r\n  height: 28px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  color: var(--accent);\r\n}\r\n\r\n/* 导航行结构（Rail 模式 icon + label 横排） */\r\n.layout__nav-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.layout__nav-icon {\r\n  flex-shrink: 0;\r\n  width: 20px;\r\n  text-align: center;\r\n  font-size: 14px;\r\n}\r\n\r\n/* Knowledge 树切换按钮（仅 <900px 显示） */\r\n.knowledge__viewbar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.knowledge__tree-toggle {\r\n  display: none;\r\n  background: transparent;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  padding: 4px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.knowledge__tree-toggle:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n/* 树 Drawer 遮罩（仅 drawer 打开时由 React 渲染） */\r\n.knowledge__tree-backdrop {\r\n  display: none;\r\n}\r\n\r\n/* Today 底部轻量 AI 行（§51-52） */\r\n.today-ai-line--action {\r\n  width: 100%;\r\n  background: transparent;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  transition: border-color 0.15s, color 0.15s;\r\n}\r\n\r\n.today-ai-line--action:hover {\r\n  border-color: var(--accent);\r\n  color: var(--fg);\r\n}\r\n\r\n.today-ai-line--primary {\r\n  border-color: var(--accent);\r\n  color: var(--fg);\r\n}\r\n\r\n.today-ai-line--primary > span:first-child {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n/* ---- 900-1279px：Sidebar 收窄；AI Panel 改 overlay Drawer（fixed，不再挤压 main） ---- */\r\n\r\n@media (max-width: 1279px) {\r\n  .layout__sidebar {\r\n    width: 190px;\r\n    padding: 20px 12px;\r\n    gap: 18px;\r\n  }\r\n\r\n  .aipanel {\r\n    position: fixed;\r\n    right: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: min(360px, 92vw);\r\n    min-width: 0;\r\n    max-width: none;\r\n    z-index: 80;\r\n    box-shadow: -10px 0 28px rgba(0, 0, 0, 0.5);\r\n    transition: transform 0.15s ease;\r\n  }\r\n}\r\n\r\n/* ---- <900px：Sidebar 折叠为窄 Rail（仅图标，hover 展开）；AI overlay；知识树 Drawer ---- */\r\n\r\n@media (max-width: 899px) {\r\n  .layout__sidebar {\r\n    position: fixed;\r\n    left: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: 54px;\r\n    padding: 14px 6px;\r\n    gap: 14px;\r\n    overflow: hidden;\r\n    z-index: 70;\r\n    transition: width 0.15s ease;\r\n  }\r\n\r\n  .layout__sidebar:hover {\r\n    width: 200px;\r\n    box-shadow: 8px 0 28px rgba(0, 0, 0, 0.5);\r\n  }\r\n\r\n  .layout__body {\r\n    margin-left: 54px;\r\n  }\r\n\r\n  .layout__brand {\r\n    flex-direction: row;\r\n    align-items: center;\r\n    padding: 0 2px;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .layout__brand-mark {\r\n    display: inline-flex;\r\n  }\r\n\r\n  .layout__brand-name {\r\n    display: none;\r\n  }\r\n\r\n  .layout__sidebar:hover .layout__brand-name {\r\n    display: inline;\r\n  }\r\n\r\n  .layout__nav-item {\r\n    justify-content: center;\r\n    padding: 10px 6px;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .layout__sidebar:hover .layout__nav-item {\r\n    justify-content: flex-start;\r\n    padding: 10px 12px;\r\n  }\r\n\r\n  .layout__nav-label {\r\n    display: none;\r\n  }\r\n\r\n  .layout__sidebar:hover .layout__nav-label {\r\n    display: inline;\r\n  }\r\n\r\n  .shell-profile {\r\n    padding: 0 2px;\r\n  }\r\n\r\n  .shell-profile__btn {\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 8px 4px;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .shell-profile__sub,\r\n  .shell-profile__arrow {\r\n    display: none;\r\n  }\r\n\r\n  .shell-profile__name {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .layout__sidebar:hover .shell-profile__btn {\r\n    align-items: flex-start;\r\n    padding: 10px 12px;\r\n  }\r\n\r\n  .layout__sidebar:hover .shell-profile__sub {\r\n    display: block;\r\n  }\r\n\r\n  .layout__sidebar:hover .shell-profile__arrow {\r\n    display: block;\r\n  }\r\n\r\n  .layout__main {\r\n    padding: 20px 16px;\r\n  }\r\n\r\n  .page,\r\n  .page--wide {\r\n    max-width: 100%;\r\n  }\r\n\r\n  .today-head {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 10px;\r\n  }\r\n\r\n  .today-head__btns {\r\n    justify-content: flex-start;\r\n  }\r\n\r\n  /* AI Panel：与 1279 档一致的 overlay Drawer */\r\n  .aipanel {\r\n    position: fixed;\r\n    right: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: min(340px, 92vw);\r\n    min-width: 0;\r\n    max-width: none;\r\n    z-index: 80;\r\n    box-shadow: -10px 0 28px rgba(0, 0, 0, 0.5);\r\n    transition: transform 0.15s ease;\r\n  }\r\n\r\n  /* Knowledge 左树：默认隐藏，经「☰ 树」切换为 fixed Drawer + 遮罩 */\r\n  .knowledge__tree {\r\n    display: none;\r\n  }\r\n\r\n  .knowledge__tree--drawer {\r\n    display: flex;\r\n    position: fixed;\r\n    left: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: min(300px, 85vw);\r\n    z-index: 75;\r\n    box-shadow: 10px 0 28px rgba(0, 0, 0, 0.5);\r\n    transition: transform 0.15s ease;\r\n  }\r\n\r\n  .knowledge__tree-backdrop {\r\n    display: block;\r\n    position: fixed;\r\n    inset: 0;\r\n    z-index: 74;\r\n    background: rgba(0, 0, 0, 0.5);\r\n  }\r\n\r\n  .knowledge__tree-toggle {\r\n    display: inline-flex;\r\n    margin-left: auto;\r\n  }\r\n\r\n  /* 月历 cell 高度收紧，避免纵向过高 */\r\n  .pcal__cell {\r\n    min-height: 56px;\r\n  }\r\n\r\n  /* 窄屏：日期抽屉时间列改为可收缩，避免挤压正文 */\r\n  .daydrawer__time {\r\n    width: auto;\r\n    min-width: 0;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n\r\n/* ============================================================ */\r\n/* ============ BATCH-04（DEV-0043 / DEV-0044 / DEV-0045） ============ */\r\n/* ============================================================ */\r\n\r\n/* ---- DEV-0043 Learning Workspace：Header 标题编辑（§54） ---- */\r\n\r\n.lw__title-btn {\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n  padding: 2px 6px;\r\n  margin-left: -6px;\r\n  text-align: left;\r\n  cursor: text;\r\n}\r\n\r\n.lw__title-btn:hover {\r\n  border-color: var(--border-strong);\r\n}\r\n\r\n.lw__title-input {\r\n  background: var(--bg);\r\n  border: 1px solid var(--accent);\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n  padding: 4px 8px;\r\n  outline: none;\r\n  width: min(420px, 100%);\r\n}\r\n\r\n/* 通栏按钮（End Sheet 选项） */\r\n.btn--block {\r\n  width: 100%;\r\n  text-align: left;\r\n}\r\n\r\n/* ---- DEV-0043 End Sheet（§59-66） ---- */\r\n\r\n.modal--endsheet {\r\n  max-width: min(92vw, 480px);\r\n  max-height: min(90vh, 720px);\r\n}\r\n\r\n.endsheet__saved {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.endsheet__stats {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 14px;\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n  margin-top: -6px;\r\n}\r\n\r\n.endsheet__title {\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  margin-top: 2px;\r\n}\r\n\r\n.endsheet__opt--open {\r\n  border-color: var(--accent);\r\n  color: var(--fg);\r\n}\r\n\r\n.endsheet__panel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 10px 12px;\r\n  margin-top: -4px;\r\n}\r\n\r\n.endsheet__preview-title {\r\n  font-size: 12.5px;\r\n  color: var(--fg);\r\n}\r\n\r\n.endsheet__pre {\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  max-height: 200px;\r\n  overflow: auto;\r\n  margin: 0;\r\n  padding: 8px 10px;\r\n}\r\n\r\n.endsheet__next {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n/* 开始下一个列表（End Sheet 与结束后视图共用） */\r\n.lw-next {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 8px;\r\n  max-height: 260px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.lw-next__item {\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  font-size: 13px;\r\n  padding: 7px 10px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.lw-next__item:hover {\r\n  border-color: var(--accent);\r\n}\r\n\r\n.lw-next__item--quick {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.lw-next__empty {\r\n  font-size: 12px;\r\n  padding: 4px 10px;\r\n}\r\n\r\n/* 删除学习记录确认 preview（§70） */\r\n.lw-del-preview {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 10px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font-size: 12.5px;\r\n  color: var(--fg-muted);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n/* ---- DEV-0044 Planning Calendar ---- */\r\n\r\n.pcal__bar-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n/* Date Detail Session 行：操作按钮组（§79） */\r\n.daydrawer__session--rich {\r\n  align-items: flex-start;\r\n}\r\n\r\n.daydrawer__session-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  margin-top: 6px;\r\n}\r\n\r\n/* ---- DEV-0044 Planning：接下来（§83）/ 无 Goal 可选区（§82） ---- */\r\n\r\n.planning-next {\r\n  margin-top: 14px;\r\n}\r\n\r\n.planning-next__groups {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.planning-next__group-title {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 8px;\r\n  padding-bottom: 6px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.planning-next__rows {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.planning-next__row {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.planning-next__check {\r\n  color: var(--fg-muted);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.planning-next__label {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.planning-next__rows .muted {\r\n  font-size: 11.5px;\r\n  margin: 0;\r\n}\r\n\r\n.planning-optional-goal {\r\n  margin-top: 14px;\r\n}\r\n\r\n@media (max-width: 899px) {\r\n  .planning-next__groups {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .lw__title-input {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n/* ============ DEV-0045 知识图（React Flow / KnowledgeFlow） ============ */\r\n\r\n/* 整体容器：顶部按钮行 + 画布（flex column 填满 knowledge__main） */\r\n.kflow {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--bg);\r\n}\r\n\r\n/* 顶部按钮行 */\r\n.kflow__bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  padding: 8px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: var(--bg);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.kflow__bar-name {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  margin-right: 4px;\r\n}\r\n\r\n/* 画布（React Flow 需要显式尺寸） */\r\n.kflow__canvas {\r\n  flex: 1;\r\n  min-height: 320px;\r\n  position: relative;\r\n}\r\n\r\n.kflow__empty {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 100%;\r\n}\r\n\r\n/* 节点卡（§116：两行内容；选中=蓝色细边框，不用大色块） */\r\n.kflow__node {\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  gap: 3px;\r\n  padding: 8px 30px 8px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 9px;\r\n  font-size: 12px;\r\n  color: var(--fg);\r\n  cursor: grab;\r\n  user-select: none;\r\n}\r\n\r\n.kflow__node:active {\r\n  cursor: grabbing;\r\n}\r\n\r\n.kflow__node--selected {\r\n  outline: 1.5px solid var(--accent);\r\n  outline-offset: 1px;\r\n}\r\n\r\n/* 当前工作区节点：普通边框微高亮（不与选中态叠加成大色块） */\r\n.kflow__node--current {\r\n  border-color: var(--border-strong);\r\n}\r\n\r\n.kflow__node-title {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  line-height: 1.3;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.kflow__node-sub {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  line-height: 1.2;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* 右上 ··· */\r\n.kflow__node-menu {\r\n  position: absolute;\r\n  top: 2px;\r\n  right: 2px;\r\n  width: 22px;\r\n  height: 22px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  letter-spacing: 1px;\r\n  cursor: pointer;\r\n}\r\n\r\n.kflow__node-menu:hover {\r\n  background: var(--bg-elevated);\r\n  color: var(--fg);\r\n}\r\n\r\n/* 连接点：隐藏视觉（仅作为边锚点） */\r\n.kflow__handle {\r\n  opacity: 0;\r\n  min-width: 4px;\r\n  min-height: 4px;\r\n  width: 4px;\r\n  height: 4px;\r\n  background: transparent;\r\n  border: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n/* 单击 Preview 浮层（React Flow 外的 fixed 小卡） */\r\n.kflow__preview {\r\n  position: fixed;\r\n  z-index: 60;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  max-height: 300px;\r\n  overflow-y: auto;\r\n  padding: 10px 12px;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 10px;\r\n  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);\r\n  font-size: 12.5px;\r\n  color: var(--fg);\r\n}\r\n\r\n.kflow__preview-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.kflow__preview-title {\r\n  font-size: 13.5px;\r\n  font-weight: 700;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.kflow__preview-close {\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.kflow__preview-close:hover {\r\n  color: var(--fg);\r\n}\r\n\r\n.kflow__preview-sub {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n  margin-top: -2px;\r\n}\r\n\r\n.kflow__preview-content {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  line-height: 1.5;\r\n  color: var(--fg);\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.kflow__preview-content--empty {\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kflow__preview-session {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  padding: 6px 8px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kflow__preview-session-label {\r\n  font-weight: 600;\r\n  color: var(--fg);\r\n}\r\n\r\n.kflow__preview-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* ··· 菜单（createPortal 到 body；fixed；viewport 翻转） */\r\n.kflow__menu-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 70;\r\n}\r\n\r\n.kflow__menu {\r\n  position: fixed;\r\n  z-index: 71;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  padding: 5px;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.kflow__menu-item {\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  text-align: left;\r\n  font-size: 12.5px;\r\n  padding: 6px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.kflow__menu-item:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.kflow__menu-item--danger {\r\n  color: var(--error);\r\n}\r\n\r\n/* React Flow 深色微调：Controls 低对比 */\r\n.kflow__canvas .react-flow__controls {\r\n  box-shadow: none;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.kflow__canvas .react-flow__controls-button {\r\n  background: var(--bg-elevated);\r\n  border-bottom: 1px solid var(--border);\r\n  color: var(--fg-muted);\r\n  width: 24px;\r\n  height: 24px;\r\n}\r\n\r\n.kflow__canvas .react-flow__controls-button:hover {\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n}\r\n\r\n.kflow__canvas .react-flow__attribution {\r\n  background: transparent;\r\n  color: var(--fg-muted);\r\n  font-size: 9px;\r\n}\r\n\r\n/* ============ DEV-0049 Fix 01：Tiptap 富文本文档编辑器 + 日期摘要 ============ */\r\n\r\n.hdoc {\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface-1, #1b1e24);\r\n  overflow: hidden;\r\n}\r\n\r\n.hdoc__toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  align-items: center;\r\n  padding: 8px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: var(--surface-2, #22262e);\r\n}\r\n\r\n.hdoc__tb-btn--active {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.hdoc .ProseMirror {\r\n  min-height: 360px;\r\n  max-height: min(62vh, 720px);\r\n  overflow-y: auto;\r\n  padding: 18px 22px 28px;\r\n  outline: none;\r\n  font-size: 14.5px;\r\n  line-height: 1.75;\r\n  min-width: 0;\r\n  word-break: break-word;\r\n}\r\n\r\n.hdoc .ProseMirror > * + * {\r\n  margin-top: 0.7em;\r\n}\r\n\r\n.hdoc .ProseMirror h2,\r\n.hdoc .ProseMirror h3 {\r\n  margin-top: 1.2em;\r\n  line-height: 1.35;\r\n}\r\n\r\n.hdoc .ProseMirror ul,\r\n.hdoc .ProseMirror ol {\r\n  padding-left: 1.5em;\r\n}\r\n\r\n.hdoc .ProseMirror > p:first-child:empty::before {\r\n  content: \"开始记录本次学习…（图片 / 视频 / 代码块会出现在光标位置）\";\r\n  color: var(--fg-muted);\r\n  float: left;\r\n  height: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n/* CustomCodeBlock NodeView（DEV-0050 §8-9）：工具栏(React) + pre(NodeViewContent) */\r\n.hdoc__codeblock {\r\n  margin: 0.8em 0;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: #14161b;\r\n  overflow: hidden;\r\n}\r\n\r\n.hdoc__codeblock--sel {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.hdoc__codebar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 6px 10px;\r\n  background: var(--surface-2, #22262e);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.hdoc__codebar-label {\r\n  font-size: 10.5px;\r\n  color: var(--fg-muted);\r\n  user-select: none;\r\n}\r\n\r\n.hdoc__codebar-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.hdoc__codebar-actions button {\r\n  background: transparent;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 11px;\r\n  line-height: 1;\r\n  padding: 4px 9px;\r\n  cursor: pointer;\r\n}\r\n\r\n.hdoc__codebar-actions button:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.hdoc__code-remove:hover {\r\n  border-color: var(--danger, #e5484d) !important;\r\n  color: var(--danger, #e5484d) !important;\r\n}\r\n\r\n.hdoc__codeblock pre {\r\n  margin: 0;\r\n  padding: 12px 14px;\r\n  font-family: Consolas, \"Cascadia Mono\", \"Courier New\", monospace;\r\n  font-size: 13px;\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n  overflow-x: auto;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.hdoc__codecontent {\r\n  display: block;\r\n  font-family: inherit;\r\n}\r\n\r\n/* 媒体块（图片/视频）：正文流内，上下可继续输入 */\r\n.hdoc__media {\r\n  position: relative;\r\n  margin: 0.8em 0;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.hdoc__media--sel {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 2px;\r\n  border-radius: 6px;\r\n}\r\n\r\n.hdoc__img,\r\n.hdoc__video {\r\n  display: block;\r\n  max-width: 100%;\r\n  height: auto;\r\n  border-radius: 8px;\r\n  border: 1px solid var(--border);\r\n}\r\n\r\n.hdoc__img {\r\n  cursor: zoom-in;\r\n}\r\n\r\n.hdoc__video {\r\n  max-height: 420px;\r\n}\r\n\r\n.hdoc__caption {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  margin-top: 4px;\r\n}\r\n\r\n.hdoc__remove {\r\n  position: absolute;\r\n  top: 6px;\r\n  right: 6px;\r\n  background: rgba(20, 22, 27, 0.85);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 11px;\r\n  padding: 3px 8px;\r\n  cursor: pointer;\r\n  opacity: 0;\r\n  transition: opacity 0.12s;\r\n}\r\n\r\n.hdoc__media:hover .hdoc__remove,\r\n.hdoc__media--sel .hdoc__remove {\r\n  opacity: 1;\r\n}\r\n\r\n.hdoc__remove:hover {\r\n  border-color: var(--danger, #e5484d);\r\n  color: var(--danger, #e5484d);\r\n}\r\n\r\n.hdoc__loading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 90px;\r\n  border: 1px dashed var(--border);\r\n  border-radius: 8px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.hdoc--drag {\r\n  outline: 2px dashed var(--accent);\r\n  outline-offset: -2px;\r\n}\r\n\r\n/* Date Detail 当天摘要行（§13.2） */\r\n.daydrawer__summary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px 18px;\r\n  padding: 8px 12px;\r\n  margin-bottom: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  background: var(--surface-2, #22262e);\r\n  font-size: 12.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ============ DEV-0050 PHASE-C/D：Planning V1（第一屏两栏 / 目标树 / 下一步 / 学习数据 / Date Detail 掌握度） ============ */\r\n\r\n/* 第一屏：左目标树 + 右下一步（宽屏两栏；<900px 单列堆叠 §33） */\r\n.planning__first {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n  gap: 14px;\r\n  align-items: start;\r\n}\r\n\r\n/* 第四部分：最近学习 */\r\n.planning-recent {\r\n  margin-top: 14px;\r\n}\r\n\r\n/* legacy 旧版规划数据轻提示（§29） */\r\n.planning__legacy {\r\n  margin-top: 12px;\r\n  font-size: 11.5px;\r\n}\r\n\r\n/* ---- 目标树 gtree（§25-26：文件树形态 / 缩进 / hover 显示 actions） ---- */\r\n\r\n.gtree {\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--bg);\r\n  padding: 12px 14px;\r\n}\r\n\r\n.gtree__head .card__title {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.gtree__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.gtree__node {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  min-height: 30px;\r\n  padding: 4px 6px;\r\n  border-radius: 7px;\r\n}\r\n\r\n.gtree__node:hover {\r\n  background: var(--bg-elevated);\r\n}\r\n\r\n.gtree__name {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n  font-size: 13px;\r\n  color: var(--fg);\r\n}\r\n\r\n/* 层级标签：仅边框/字色区分层级（final=蓝 / year=黄 / month=绿 / day=灰） */\r\n.gtree__level-tag {\r\n  flex-shrink: 0;\r\n  font-size: 10.5px;\r\n  line-height: 1.4;\r\n  padding: 1px 7px;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--border-strong);\r\n  color: var(--fg-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.gtree__level-tag--final {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.gtree__level-tag--year {\r\n  border-color: var(--warn);\r\n  color: var(--warn);\r\n}\r\n\r\n.gtree__level-tag--month {\r\n  border-color: var(--ok);\r\n  color: var(--ok);\r\n}\r\n\r\n.gtree__level-tag--day {\r\n  border-color: var(--border-strong);\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* hover 才显示操作（默认半透明弱化） */\r\n.gtree__actions {\r\n  display: flex;\r\n  gap: 2px;\r\n  flex-shrink: 0;\r\n  opacity: 0.35;\r\n  transition: opacity 0.12s;\r\n}\r\n\r\n.gtree__node:hover .gtree__actions,\r\n.gtree__actions:focus-within {\r\n  opacity: 1;\r\n}\r\n\r\n.gtree__act {\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 5px;\r\n  color: var(--fg-muted);\r\n  font-size: 11.5px;\r\n  padding: 3px 6px;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n\r\n.gtree__act:hover {\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n}\r\n\r\n.gtree__act--danger,\r\n.gtree__act--danger:hover {\r\n  color: var(--error);\r\n}\r\n\r\n/* ---- 下一步 nextstep（§35-38：主推荐 + 今天剩余 + 未来 7 天） ---- */\r\n\r\n.nextstep {\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--bg);\r\n  padding: 12px 14px;\r\n}\r\n\r\n.nextstep .card__title {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.nextstep__primary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  padding: 4px 2px 10px;\r\n}\r\n\r\n.nextstep__label {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.nextstep__title {\r\n  font-size: 17px;\r\n  font-weight: 700;\r\n  line-height: 1.35;\r\n  color: var(--fg);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.nextstep__path {\r\n  font-size: 12px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.nextstep__sec {\r\n  margin-top: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.nextstep__sec-title {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n/* 轻列表行：hover 背景反馈 */\r\n.nextstep__item {\r\n  display: flex;\r\n  width: 100%;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 7px;\r\n  color: var(--fg);\r\n  font-size: 12.5px;\r\n  text-align: left;\r\n  padding: 5px 8px;\r\n  cursor: pointer;\r\n}\r\n\r\n.nextstep__item:hover {\r\n  background: var(--bg-elevated);\r\n}\r\n\r\n.nextstep__item > span:first-child {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.nextstep__item .muted {\r\n  flex-shrink: 0;\r\n  font-size: 11px;\r\n}\r\n\r\n/* ---- 学习数据 ldata（§41-60：三指标 + 周期切换 + 三组趋势 bar） ---- */\r\n\r\n.ldata {\r\n  margin-top: 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--bg);\r\n  padding: 12px 14px;\r\n}\r\n\r\n.ldata__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.ldata__head .card__title {\r\n  margin: 0;\r\n}\r\n\r\n.ldata__switch {\r\n  display: flex;\r\n  gap: 2px;\r\n  padding: 2px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n\r\n.ldata__kind {\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  padding: 4px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.ldata__kind:hover {\r\n  color: var(--fg);\r\n}\r\n\r\n.ldata__kind--active {\r\n  background: var(--accent);\r\n  color: #fff;\r\n}\r\n\r\n.ldata__nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-left: auto;\r\n}\r\n\r\n.ldata__period-label {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  min-width: 96px;\r\n  text-align: center;\r\n}\r\n\r\n/* 三指标格 */\r\n.ldata__metrics {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin-top: 12px;\r\n}\r\n\r\n.ldata__metric {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 9px;\r\n  padding: 10px 12px;\r\n}\r\n\r\n.ldata__metric-label {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* 大数字 */\r\n.ldata__metric-value {\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  color: var(--fg);\r\n  line-height: 1.25;\r\n}\r\n\r\n/* 掌握度值按钮：未评估虚线弱化；已有评估实线可点开详情 */\r\n.ldata__mastery {\r\n  align-self: flex-start;\r\n  background: transparent;\r\n  border: 1px dashed var(--border-strong);\r\n  border-radius: 8px;\r\n  color: var(--fg-muted);\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n  padding: 2px 12px;\r\n  cursor: default;\r\n}\r\n\r\n.ldata__mastery--has {\r\n  border-style: solid;\r\n  border-color: var(--accent);\r\n  color: var(--fg);\r\n  cursor: pointer;\r\n}\r\n\r\n.ldata__mastery--has:hover {\r\n  background: rgba(79, 140, 255, 0.1);\r\n}\r\n\r\n/* AI 小徽标 */\r\n.ldata__ai-tag {\r\n  display: inline-block;\r\n  margin-left: 4px;\r\n  padding: 0 6px;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 999px;\r\n  font-size: 10px;\r\n  font-weight: 400;\r\n  color: var(--fg-muted);\r\n  vertical-align: 1px;\r\n}\r\n\r\n/* stale：已有新学习记录，评估可能过期（橙字） */\r\n.ldata__stale {\r\n  font-size: 11px;\r\n  color: var(--warn);\r\n}\r\n\r\n/* 三组趋势（<900px 单列） */\r\n.ldata__trends {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin-top: 12px;\r\n}\r\n\r\n.ldata__trend {\r\n  border: 1px solid var(--border);\r\n  border-radius: 9px;\r\n  padding: 8px 10px;\r\n}\r\n\r\n.ldata__trend-title {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.ldata__bars {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 3px;\r\n  height: 50px;\r\n}\r\n\r\n.ldata__bar-slot {\r\n  width: 10px;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: center;\r\n}\r\n\r\n.ldata__bar {\r\n  width: 100%;\r\n  min-height: 2px;\r\n  background: var(--accent);\r\n  border-radius: 3px 3px 2px 2px;\r\n}\r\n\r\n/* 未评估：不补 0，显示灰点 */\r\n.ldata__bar--empty {\r\n  width: 4px;\r\n  min-height: 3px;\r\n  background: var(--border-strong);\r\n  border-radius: 999px;\r\n}\r\n\r\n.ldata__trend-edges {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 10.5px;\r\n  margin-top: 4px;\r\n}\r\n\r\n/* Mastery 详情（§54） */\r\n.ldata__dims {\r\n  display: flex;\r\n  gap: 14px;\r\n  flex-wrap: wrap;\r\n  font-size: 12.5px;\r\n  margin: 6px 0;\r\n}\r\n\r\n.ldata__sec {\r\n  margin-top: 8px;\r\n}\r\n\r\n.ldata__sec-title {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 3px;\r\n}\r\n\r\n.ldata__sec-list {\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  font-size: 12.5px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.ldata__detail-foot {\r\n  display: flex;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  font-size: 11.5px;\r\n  margin-top: 8px;\r\n}\r\n\r\n/* Date Detail 掌握度值（§40：复用摘要行 compact 样式，值本身可点击评估） */\r\n.daydrawer__mastery-btn {\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 0;\r\n  color: var(--fg);\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  text-decoration: underline dotted;\r\n  text-underline-offset: 3px;\r\n  cursor: pointer;\r\n}\r\n\r\n.daydrawer__mastery-btn:hover {\r\n  color: var(--accent);\r\n}\r\n\r\n.daydrawer__mastery-btn:disabled {\r\n  cursor: wait;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* <900px：第一屏单列堆叠；学习数据趋势单列 */\r\n@media (max-width: 899px) {\r\n  .planning__first {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .ldata__trends {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* ============================================================ */\r\n/* ============ DEV-0051：Knowledge Workspace V2 + AI Panel Compact ============ */\r\n/* ============================================================ */\r\n\r\n/* ---- PHASE-A（§24-25）：三区独立滚动 ----\r\n   Tree 左栏已独立滚动（.knowledge__tree-body overflow-y:auto）；\r\n   Workspace 用内层 .kws 滚动（viewbar 固定）；AI Panel .aipanel__messages 独立滚动。\r\n   不用巨大固定高度解决滚动。 */\r\n\r\n.knowledge__main {\r\n  overflow: hidden;\r\n}\r\n\r\n.kws {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  padding-right: 4px;\r\n}\r\n\r\n.aipanel__messages {\r\n  min-height: 0;\r\n}\r\n\r\n/* 文档编辑模式：编辑器随外层 .kws 滚动（解除 62vh 内部上限，避免双层滚动） */\r\n.kws--doc .hdoc .ProseMirror {\r\n  max-height: none;\r\n}\r\n\r\n/* ---- Workspace Header（§27） ---- */\r\n\r\n.kws__head {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.kws__stats {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kws__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 2px;\r\n}\r\n\r\n/* ---- 内容时间线（§28-34） ---- */\r\n\r\n.kws__timeline {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.kws__group-title {\r\n  font-size: 11.5px;\r\n  font-weight: 600;\r\n  color: var(--fg-muted);\r\n  padding: 6px 2px 4px;\r\n  border-bottom: 1px dashed var(--border);\r\n}\r\n\r\n.kws__card {\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 10px 14px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n}\r\n\r\n.kws__card-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kws__card-kind {\r\n  padding: 0 8px;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 999px;\r\n  font-size: 10.5px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.kws__card-kind--doc {\r\n  border-color: rgba(79, 140, 255, 0.5);\r\n  color: var(--accent);\r\n}\r\n\r\n.kws__card-flag {\r\n  color: var(--warn);\r\n}\r\n\r\n.kws__card-title {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--fg);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.kws__card-sub {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kws__card-summary {\r\n  margin: 0;\r\n  font-size: 12.5px;\r\n  line-height: 1.6;\r\n  color: var(--fg);\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.kws__card-summary--muted {\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.kws__card-media {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.kws__card-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-top: 2px;\r\n}\r\n\r\n.kws__card-btn {\r\n  background: transparent;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 999px;\r\n  color: var(--fg-muted);\r\n  font-size: 11px;\r\n  padding: 2px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.kws__card-btn:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n/* 卡片 ⋯ 菜单（fixed backdrop + 卡内 absolute 菜单，同树菜单模式） */\r\n.kws__menu-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 60;\r\n}\r\n\r\n.kws__menu {\r\n  position: absolute;\r\n  top: 32px;\r\n  right: 10px;\r\n  z-index: 61;\r\n  min-width: 120px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  padding: 5px;\r\n  background: var(--bg-elevated);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 8px;\r\n  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.kws__menu-item {\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  color: var(--fg);\r\n  text-align: left;\r\n  font-size: 12.5px;\r\n  padding: 6px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.kws__menu-item:hover {\r\n  background: var(--bg);\r\n}\r\n\r\n.kws__menu-item--danger {\r\n  color: var(--error);\r\n}\r\n\r\n/* 卡内重命名（session 修改标题 / 文档重命名） */\r\n.kws__rename {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n/* 空态 / 加载 */\r\n.kws__empty,\r\n.kws__loading {\r\n  margin: 8px 2px;\r\n  font-size: 12.5px;\r\n}\r\n\r\n/* ---- Legacy 附件（§45-46） ---- */\r\n\r\n.kws__legacy {\r\n  border-top: 1px dashed var(--border);\r\n  padding-top: 10px;\r\n}\r\n\r\n.kws__legacy-head {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  margin-bottom: 8px;\r\n}\r\n\r\n/* ---- 文档详情模式（§36-37） ---- */\r\n\r\n.kws__detail-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.kws__back {\r\n  background: transparent;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  padding: 4px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.kws__back:hover {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n/* 修正学习时间 Modal 行 */\r\n.kws__fixrow {\r\n  display: grid;\r\n  grid-template-columns: auto 1fr auto 1fr;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin: 8px 0 4px;\r\n  font-size: 12.5px;\r\n}\r\n\r\n.kws__fixrow input {\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 6px;\r\n  padding: 5px 8px;\r\n  font-size: 12px;\r\n  font-family: inherit;\r\n}\r\n\r\n@m