n-width: 34px;\r\n}\r\n\r\n.knowledge__recent-evals-outcome {\r\n  font-weight: 600;\r\n}\r\n\r\n.knowledge__recent-evals-outcome--passed {\r\n  color: var(--ok);\r\n}\r\n\r\n.knowledge__recent-evals-outcome--partial {\r\n  color: var(--warn);\r\n}\r\n\r\n.knowledge__recent-evals-outcome--failed {\r\n  color: var(--error);\r\n}\r\n\r\n.knowledge__recent-evals-outcome--unrated {\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.knowledge__foot-note {\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ============ DEV-0013 Feedback ============ */\r\n\r\n.review-feedback {\r\n  list-style: none;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.review-feedback__item {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 8px 12px;\r\n  background: rgba(210, 153, 34, 0.06);\r\n  border: 1px solid rgba(210, 153, 34, 0.25);\r\n  border-radius: 8px;\r\n}\r\n\r\n.review-feedback__title {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.review-feedback__meta {\r\n  font-size: 11px;\r\n  text-align: right;\r\n}\r\n\r\n.review-flag {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.review-flag__item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  font-size: 13px;\r\n  padding: 8px 14px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n\r\n.review-flag__name {\r\n  font-weight: 600;\r\n  min-width: 90px;\r\n}\r\n\r\n.review-flag__done {\r\n  margin-left: auto;\r\n  font-size: 12px;\r\n  color: var(--ok);\r\n}\r\n\r\n.review-flag__item .btn {\r\n  margin-left: auto;\r\n}\r\n\r\n/* FeedbackCard（DEV-0014） */\r\n.review-feedback__item {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.review-feedback__type {\r\n  display: inline-block;\r\n  font-size: 11px;\r\n  color: var(--warn);\r\n  border: 1px solid rgba(210, 153, 34, 0.4);\r\n  border-radius: 999px;\r\n  padding: 0 8px;\r\n  margin-right: 8px;\r\n  vertical-align: 1px;\r\n}\r\n\r\n.review-feedback__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.review-feedback__hint {\r\n  width: 100%;\r\n  font-size: 12px;\r\n  color: var(--ok);\r\n}\r\n\r\n.review-feedback__hint--err {\r\n  color: var(--error);\r\n}\r\n\r\n/* ============ DEV-0015 Insight / 周期复盘 ============ */\r\n\r\n/* 复盘窗口切换 */\r\n.review-window {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.review-window__item {\r\n  background: var(--bg);\r\n  color: var(--fg-muted);\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  padding: 5px 14px;\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n}\r\n\r\n.review-window__item:hover {\r\n  border-color: var(--accent);\r\n  color: var(--fg);\r\n}\r\n\r\n.review-window__item--active {\r\n  background: var(--accent);\r\n  border-color: var(--accent);\r\n  color: #fff;\r\n}\r\n\r\n/* 周期内解决 */\r\n.review-solved {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n}\r\n\r\n.review-solved__item {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  font-size: 13px;\r\n  padding: 6px 12px;\r\n  background: rgba(63, 185, 80, 0.06);\r\n  border: 1px solid rgba(63, 185, 80, 0.25);\r\n  border-radius: 8px;\r\n}\r\n\r\n/* 周期内调整（问题 → 调整 → 执行） */\r\n.review-adjust {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.review-adjust__item {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 8px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n.review-adjust__chain {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  min-width: 0;\r\n}\r\n\r\n.review-adjust__type {\r\n  font-size: 11px;\r\n  color: var(--accent);\r\n}\r\n\r\n.review-adjust__title {\r\n  font-weight: 500;\r\n}\r\n\r\n/* Progress：30 天趋势（纯 CSS 柱状，无图表库） */\r\n.trend {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.trend__bars {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 2px;\r\n  height: 90px;\r\n}\r\n\r\n.trend__bar {\r\n  flex: 1;\r\n  min-width: 4px;\r\n  background: var(--bg-elevated);\r\n  border-radius: 2px 2px 0 0;\r\n}\r\n\r\n.trend__bar--active {\r\n  background: var(--accent);\r\n  opacity: 0.75;\r\n}\r\n\r\n.trend__meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 16px;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* Progress：下一步 */\r\n.next-actions {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.next-actions__item {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 14px;\r\n  font-size: 13px;\r\n  padding: 8px 12px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n}\r\n\r\n.next-actions__date {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n  min-width: 46px;\r\n}\r\n\r\n.next-actions__title {\r\n  font-weight: 500;\r\n}\r\n\r\n.next-actions__source {\r\n  font-size: 11px;\r\n  margin-left: auto;\r\n  text-align: right;\r\n}\r\n\r\n/* ============ DEV-0016 Settings ============ */\r\n\r\n.settings-profile__name {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.settings-ai-note {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--fg-muted);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.layout__sidebar-footer {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 10px 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n/* ============ DEV-0017 Learning Workspace ============ */\r\n\r\n.lw__header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.lw__title {\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n}\r\n\r\n.lw__breadcrumb {\r\n  font-size: 12px;\r\n  margin-top: 2px;\r\n}\r\n\r\n.lw__meta {\r\n  font-size: 11px;\r\n  margin-top: 4px;\r\n}\r\n\r\n.lw__header-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.lw__timer {\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--fg-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.lw-editor__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.lw-note {\r\n  width: 100%;\r\n  min-height: 46vh;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  color: var(--fg);\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n  padding: 14px 16px;\r\n  resize: vertical;\r\n  font-family: inherit;\r\n}\r\n\r\n.lw-note:focus {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n}\r\n\r\n.lw-ended__stats {\r\n  display: flex;\r\n  gap: 18px;\r\n  margin: 10px 0;\r\n  font-size: 13px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n/* ============ DEV-0024 Learning Editor V2 ============ */\r\n\r\n.leditor {\r\n  position: relative;\r\n}\r\n\r\n.leditor--drag {\r\n  outline: 2px dashed var(--accent);\r\n  outline-offset: -6px;\r\n  border-radius: 8px;\r\n}\r\n\r\n.leditor__toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.leditor__hint {\r\n  font-size: 11px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.leditor__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.leditor__text {\r\n  width: 100%;\r\n  min-height: 72px;\r\n  background: var(--bg);\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: var(--fg);\r\n  font-size: 14px;\r\n  line-height: 1.75;\r\n  padding: 10px 12px;\r\n  resize: vertical;\r\n  font-family: inherit;\r\n}\r\n\r\n.leditor__text:focus {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n}\r\n\r\n.leditor__media {\r\n  position: relative;\r\n}\r\n\r\n/* Word-like 图片：左对齐 / 不超正文宽 / 保持比例 / 段落间距（gap 提供） */\r\n.leditor__img {\r\n  display: block;\r\n  max-width: 100%;\r\n  height: auto;\r\n  width: auto;\r\n  border-radius: 6px;\r\n  cursor: zoom-in;\r\n  border: 1px solid var(--border);\r\n}\r\n\r\n.leditor__video {\r\n  display: block;\r\n  max-width: 100%;\r\n  border-radius: 6px;\r\n  border: 1px solid var(--border);\r\n  background: #000;\r\n}\r\n\r\n.leditor__remove {\r\n  position: absolute;\r\n  top: 6px;\r\n  right: 6px;\r\n  background: rgba(0, 0, 0, 0.65);\r\n  color: #fff;\r\n  border: 0;\r\n  border-radius: 6px;\r\n  font-size: 11px;\r\n  padding: 2px 8px;\r\n  cursor: pointer;\r\n}\r\n\r\n.leditor__remove:hover {\r\n  background: var(--error);\r\n}\r\n\r\n.leditor__loading {\r\n  color: var(--fg-muted);\r\n  font-size: 12px;\r\n  padding: 8px 0;\r\n}\r\n\r\n.leditor__dropzone {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: rgba(0, 0, 0, 0.45);\r\n  color: #fff;\r\n  font-size: 14px;\r\n  border-radius: 8px;\r\n  pointer-events: none;\r\n}\r\n\r\n.lw-ended__review {\r\n  margin-top: 12px;\r\n  border-top: 1px solid var(--border);\r\n  padding-top: 12px;\r\n}\r\n\r\n/* Note 只读渲染（Knowledge 学习记录 / Review） */\r\n.noteview {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.noteview__text {\r\n  margin: 0;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  font-size: 12.5px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.noteview__img {\r\n  display: block;\r\n  max-width: 100%;\r\n  height: auto;\r\n  width: auto;\r\n  border-radius: 6px;\r\n  border: 1px solid var(--border);\r\n  cursor: zoom-in;\r\n}\r\n\r\n.noteview__video {\r\n  display: block;\r\n  max-width: 100%;\r\n  border-radius: 6px;\r\n  border: 1px solid var(--border);\r\n  background: #000;\r\n}\r\n\r\n/* ============ DEV-0025 Today Task Center V2 ============ */\r\n\r\n.today__filters {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin: 8px 0 12px;\r\n}\r\n\r\n.chip {\r\n  background: transparent;\r\n  border: 1px solid var(--border);\r\n  color: var(--fg-muted);\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  padding: 2px 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.chip--active {\r\n  border-color: var(--accent);\r\n  color: var(--accent);\r\n}\r\n\r\n.taskrow-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.taskrow {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px 4px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.taskrow:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.taskrow__check {\r\n  background: none;\r\n  border: 0;\r\n  font-size: 20px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n  color: var(--fg-muted);\r\n  padding: 2px 6px;\r\n}\r\n\r\n.taskrow__check:hover {\r\n  color: var(--accent);\r\n}\r\n\r\n.taskrow--done .taskrow__check {\r\n  color: var(--accent);\r\n}\r\n\r\n.taskrow__main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.taskrow__title {\r\n  font-size: 14px;\r\n}\r\n\r\n.taskrow--done .taskrow__title {\r\n  color: var(--fg-muted);\r\n  text-decoration: line-through;\r\n}\r\n\r\n.taskrow__meta {\r\n  font-size: 11.5px;\r\n  color: var(--fg-muted);\r\n}\r\n\r\n.taskrow__actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* TaskModal 知识选择器 */\r\n.taskmodal__picker {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.taskmodal__search {\r\n  flex: 1;\r\n}\r\n\r\n.taskmodal__list {\r\n  max-height: 160px;\r\n  overflow-y: auto;\r\n  border: 1px solid var(--border);\r\n  border-radius: 